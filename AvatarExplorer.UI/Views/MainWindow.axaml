<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:ui="clr-namespace:AvatarExplorer.UI"
        xmlns:localization="clr-namespace:AvatarExplorer.UI.Localization"
        xmlns:common="clr-namespace:AvatarExplorer.Core.Models.Common;assembly=AvatarExplorer.Core"
        x:Class="AvatarExplorer.UI.MainWindow"
        x:DataType="localization:Localizer"
        Icon="avares://AvatarExplorer/Assets/Internal/SoftwareIcon.png"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="Main_DragDrop_Over"
        DragDrop.Drop="Main_DragDrop_Drop"
        Closing="Main_Closing"
        Loaded="Main_Loaded"
        FontFamily="avares://AvatarExplorer/Assets/Fonts#Noto Sans JP"
        MinWidth="1280"
        MinHeight="720"
        Width="1280"
        Height="720">

    <Panel x:Name="WindowPanel" PointerPressed="Main_PointerPressed">

        <!-- メイン画面 -->
        <DockPanel x:Name="Main_DockPanel" Margin="12" IsVisible="False">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Grid.Column="1" Classes="panelbackground">
                    <Grid ColumnDefinitions="Auto,Auto,2.3*,Auto,*,Auto" ColumnSpacing="10">
                        <Button Classes="button" Grid.Column="0" Content="{materialIcons:MaterialIconExt Kind=ArrowLeft}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="35" FontSize="19" CornerRadius="8" Padding="15,0,15,0" Click="Main_UndoButton_Click"/>
                        <Button Classes="button" Grid.Column="1" Content="{materialIcons:MaterialIconExt Kind=HomeOutline}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="35" FontSize="19" CornerRadius="8" Padding="15,0,15,0" Click="Main_HomeButton_Click"/>
                        
                        <TextBox x:Name="Main_PathTextBox" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" PlaceholderText="{Binding [Main.Path.Placeholder]}" IsReadOnly="True" FontSize="14" CornerRadius="8"/>
                        
                        <materialIcons:MaterialIcon Grid.Column="3" Kind="Magnify" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox x:Name="Main_SearchTextBox" Grid.Column="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" PlaceholderText="{Binding [Main.Search.Placeholder]}" FontSize="14" CornerRadius="8" TextChanged="Main_SearchValue_Changed"/>
                        
                        <Button Classes="accentbutton" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="8" Margin="5,0,0,0" Click="Main_AddItem_Click">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <materialIcons:MaterialIcon Kind="Plus" Width="25" Height="25" VerticalAlignment="Center"/>
                                <TextBlock Classes="accentbutton" FontSize="15" FontWeight="Bold" Text="{Binding [Main.AddItem]}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Classes="panelbackground">
                    <Button Classes="button" FontWeight="Bold" Content="{materialIcons:MaterialIconExt Kind=CogOutline}" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="35" Width="35" FontSize="19" CornerRadius="8" Click="Main_SettingsButton_Click"/>
                </Border>
            </Grid>

            <Panel Margin="0,12,-12,0">
                <Grid x:Name="Main_PanelGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MinWidth="250" Width="300" MaxWidth="550"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition MinWidth="250" Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition MinWidth="50" Width="50" MaxWidth="550"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border x:Name="Main_LeftPanelBorder" Grid.Column="0" Classes="panelbackground">
                        <Grid RowDefinitions="Auto,*">
                            <TabControl x:Name="Main_LeftFilter" Grid.Row="0" HorizontalAlignment="Stretch" SelectedIndex="0" Margin="-5,-10,5,5" FontSize="18" SelectionChanged="Main_LeftFilter_SelectionChanged">
                                <TabItem Header="{Binding [Main.Filter.Avatar]}" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                                <TabItem Header="{Binding [Main.Filter.Author]}" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                                <TabItem Header="{Binding [Main.Filter.Category]}" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                            </TabControl>

                            <Grid RowDefinitions="*,Auto" Grid.Row="1" RowSpacing="5">
                                <Panel Grid.Row="0">
                                    <Border CornerRadius="8" ClipToBounds="True">
                                        <ScrollViewer x:Name="Main_LeftPanelScrollViewer">
                                            <StackPanel x:Name="Main_LeftPanel" Spacing="5" Margin="0,0,10,0"/>
                                        </ScrollViewer>
                                    </Border>
                                </Panel>

                                <Panel x:Name="Main_LeftPanelPageInfo" Grid.Row="1"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Opacity="0"/>

                    <Border x:Name="Main_RightPanelBorder" Grid.Column="2" Classes="panelbackground">
                        <Panel>
                            <StackPanel x:Name="Main_RightPanelParent" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsVisible="False">
                                <Image Source="avares://AvatarExplorer/Assets/Internal/EmptyIcon.png" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [Error.Nothing]}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="25" Foreground="{DynamicResource Text.Primary}"/>
                            </StackPanel>

                            <Grid RowDefinitions="*,Auto" RowSpacing="5">
                                <Panel Grid.Row="0">
                                    <Border CornerRadius="8" ClipToBounds="True">
                                        <ScrollViewer x:Name="Main_RightPanelScrollViewer">
                                            <StackPanel x:Name="Main_RightPanel" Spacing="8" Margin="0,0,10,0"/>
                                        </ScrollViewer>
                                    </Border>
                                </Panel>

                                <Panel x:Name="Main_RightPanelPageInfo" Grid.Row="1"/>
                            </Grid>
                        </Panel>
                    </Border>

                    <GridSplitter Grid.Column="3" Opacity="0" IsVisible="{Binding #Main_SidePanelBorder.IsVisible}"/>

                    <Panel x:Name="Main_SidePanel" Grid.Column="4" HorizontalAlignment="Stretch">
                        <Border Classes="panelbackground" IsVisible="{Binding !#Main_SidePanelBorder.IsVisible}" CornerRadius="12,0,0,12" Width="50">
                            <StackPanel Spacing="10">
                                <Button Classes="button sidepanelbutton" Content="{materialIcons:MaterialIconExt Kind=TextSearch}" ToolTip.Tip="{Binding [SidePanel.AdvancedSearch]}" FontSize="17" Tag="0" Click="SidePanel_Item_Click"/>
                                <Button Classes="button sidepanelbutton" Content="{materialIcons:MaterialIconExt Kind=DownloadMultiple}" ToolTip.Tip="{Binding [SidePanel.BulkImport]}" FontSize="17" Tag="1" Click="SidePanel_Item_Click"/>
                                <Button Classes="button sidepanelbutton" Content="{materialIcons:MaterialIconExt Kind=FolderStarMultipleOutline}" ToolTip.Tip="{Binding [SidePanel.BulkImportPreset]}" FontSize="17" Tag="2" Click="SidePanel_Item_Click"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="Main_SidePanelBorder" Classes="panelbackground" IsVisible="False" CornerRadius="12,0,0,12">
                            <Grid RowSpacing="10">
                                <Grid Grid.Row="2" ColumnSpacing="10">
                                    <TabControl x:Name="SidePanel_TabControl" HorizontalAlignment="Stretch" SelectedIndex="0" FontSize="18" Margin="0,0,-10,0" TabStripPlacement="Right">
                                        <TabItem x:Name="SidePanel_AdvancedSearchTab" ToolTip.Tip="{Binding [SidePanel.AdvancedSearch]}">
                                            <TabItem.Header>
                                                <materialIcons:MaterialIcon Kind="TextSearch" Width="16" Height="16"/>
                                            </TabItem.Header>
                                            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" VerticalAlignment="Stretch">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding [SidePanel.AdvancedSearch]}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                                                    <TextBlock Text="{Binding [AdvancedSearch.NegationHint]}" FontSize="12" Opacity="0.75" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}"/>
                                                </StackPanel>
                                                <Separator Classes="separator" Grid.Row="1"/>

                                                <ScrollViewer Grid.Row="2" VerticalAlignment="Stretch">
                                                    <StackPanel Spacing="14" Margin="0,10,10,0">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="{Binding [AdvancedSearch.OrSearch]}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                                                            <Separator Classes="separator"/>
                                                            <ToggleSwitch x:Name="AdvancedSearchPanel_OrSearch" VerticalAlignment="Center" HorizontalAlignment="Left" IsCheckedChanged="Main_SearchValue_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="{Binding [AdvancedSearch.CategoryOrSearch]}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                                                            <Separator Classes="separator"/>
                                                            <ToggleSwitch x:Name="AdvancedSearchPanel_CategoryOrSearch" VerticalAlignment="Center" HorizontalAlignment="Left" IsCheckedChanged="Main_SearchValue_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="{Binding [AdvancedSearch.Title]}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                                                            <Separator Classes="separator"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_Title" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.Title]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="{Binding [AdvancedSearch.Author]}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                                                            <Separator Classes="separator"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_Author" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.Author]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="{Binding [AdvancedSearch.BoothId]}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                                                            <Separator Classes="separator"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_Booth" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.BoothId]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="{Binding [AdvancedSearch.SupportedAvatar]}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                                                            <Separator Classes="separator"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_Avatar" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.SupportedAvatar]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="{Binding [AdvancedSearch.EmptySupportedAvatarAsNone]}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                                                            <Separator Classes="separator"/>
                                                            <ToggleSwitch x:Name="AdvancedSearchPanel_EmptySupportedAvatarAsNone" VerticalAlignment="Center" HorizontalAlignment="Left" IsCheckedChanged="Main_SearchValue_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="{Binding [AdvancedSearch.Category]}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                                                            <Separator Classes="separator"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_Category" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.Category]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="{Binding [AdvancedSearch.Memo]}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                                                            <Separator Classes="separator"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_Memo" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.Memo]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="{Binding [AdvancedSearch.Folder]}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                                                            <Separator Classes="separator"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_Folder" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.Folder]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="{Binding [AdvancedSearch.File]}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                                                            <Separator Classes="separator"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_File" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.File]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="{Binding [AdvancedSearch.ImplementedAvatar]}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                                                            <Separator Classes="separator"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_Implemented" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.ImplementedAvatar]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="{Binding [AdvancedSearch.NotImplementedAvatar]}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                                                            <Separator Classes="separator"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_NotImplemented" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.NotImplementedAvatar]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="{Binding [AdvancedSearch.Tag]}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                                                            <Separator Classes="separator"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_Tag" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.Tag]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="{Binding [AdvancedSearch.CommonAvatar]}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                                                            <Separator Classes="separator"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_CommonAvatar" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.CommonAvatar]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </TabItem>

                                        <TabItem x:Name="SidePanel_BulkImportPanelTab" ToolTip.Tip="{Binding [SidePanel.BulkImport]}">
                                            <TabItem.Header>
                                                <materialIcons:MaterialIcon Kind="DownloadMultiple" Width="16" Height="16"/>
                                            </TabItem.Header>
                                            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" VerticalAlignment="Stretch">
                                                <TextBlock Text="{Binding [SidePanel.BulkImport]}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>

                                                <Separator Classes="separator" Grid.Row="1"/>

                                                <Grid Grid.Row="2" RowDefinitions="*,Auto,Auto" RowSpacing="10" Margin="-10,0,-10,0" VerticalAlignment="Stretch">
                                                    <ScrollViewer x:Name="SidePanel_BulkImportPanelScrollViewer" Grid.Row="0" DragDrop.AllowDrop="True" DragDrop.Drop="BulkImportPanel_DragDrop_Drop">
                                                        <StackPanel x:Name="SidePanel_BulkImportPanel" Spacing="5" Margin="0,0,10,0"/>
                                                    </ScrollViewer>
                                                    <Button Grid.Row="1" Classes="accentbutton" FontWeight="Bold" Content="{Binding [BulkImport.Import]}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="42" CornerRadius="8" Click="BulkImportPanel_Import_Click"/>
                                                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
                                                        <Button Grid.Column="0" Classes="accentbutton" FontWeight="Bold" Content="{Binding [BulkImport.Save]}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="42" CornerRadius="8" Click="BulkImportPanel_Save_Click"/>
                                                        <Button Grid.Column="1" Classes="button" FontWeight="Bold" Content="{Binding [BulkImport.Reset]}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="42" CornerRadius="8" Click="BulkImportPanel_Reset_Click"/>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </TabItem>

                                        <TabItem x:Name="SidePanel_BulkImportPresetPanelTab" ToolTip.Tip="{Binding [SidePanel.BulkImportPreset]}">
                                            <TabItem.Header>
                                                <materialIcons:MaterialIcon Kind="FolderStarMultipleOutline" Width="16" Height="16"/>
                                            </TabItem.Header>
                                            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" VerticalAlignment="Stretch">
                                                <TextBlock Text="{Binding [SidePanel.BulkImportPreset]}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>

                                                <Separator Classes="separator" Grid.Row="1"/>

                                                <Grid Grid.Row="2" RowDefinitions="*,Auto,Auto" RowSpacing="10" Margin="-10,0,-10,0" VerticalAlignment="Stretch">
                                                    <ScrollViewer x:Name="SidePanel_BulkImportPresetPanelScrollViewer" Grid.Row="0" DragDrop.AllowDrop="True">
                                                        <StackPanel x:Name="SidePanel_BulkImportPresetPanel" Spacing="5" Margin="0,0,10,0"/>
                                                    </ScrollViewer>
                                                </Grid>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Grid>
                        </Border>
                    </Panel>
                </Grid>
            </Panel>
        </DockPanel>

        <!-- 設定画面 -->
        <Border x:Name="SettingsOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="900" Height="650">
                <Grid RowDefinitions="*,5,Auto">
                    <TabControl Grid.Row="0" TabStripPlacement="Left">

                        <TabItem Header="{Binding [Settings.Basic]}" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}">
                            <Panel>
                                <ScrollViewer>
                                    <StackPanel Spacing="20" Margin="0,0,10,0">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.Language.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.Language.Description]}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,2.5*">
                                                <ComboBox Grid.Column="1" x:Name="SettingsOverlay_LanguageComboBox" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.SortOrder.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.SortOrder.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,2.5*">
                                                <ComboBox Grid.Column="1" x:Name="SettingsOverlay_SortOrderComboBox" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                    <ComboBoxItem Content="{Binding [Settings.SortOrder.Options.Title]}"/>
                                                    <ComboBoxItem Content="{Binding [Settings.SortOrder.Options.Author]}"/>
                                                    <ComboBoxItem Content="{Binding [Settings.SortOrder.Options.Created]}"/>
                                                    <ComboBoxItem Content="{Binding [Settings.SortOrder.Options.Updated]}"/>
                                                </ComboBox>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.Theme.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.Theme.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,2.5*">
                                                <ComboBox Grid.Column="1" x:Name="SettingsOverlay_ThemeComboBox" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                    <ComboBoxItem Content="{Binding [Settings.Theme.Options.Dark]}"/>
                                                    <ComboBoxItem Content="{Binding [Settings.Theme.Options.Light]}"/>
                                                    <ComboBoxItem Content="{Binding [Settings.Theme.Options.Sakura]}"/>
                                                    <ComboBoxItem Content="{Binding [Settings.Theme.Options.Mint]}"/>
                                                    <ComboBoxItem Content="{Binding [Settings.Theme.Options.Lavender]}"/>
                                                    <ComboBoxItem Content="{Binding [Settings.Theme.Options.Ocean]}"/>
                                                    <ComboBoxItem Content="{Binding [Settings.Theme.Options.Sunset]}"/>
                                                    <ComboBoxItem Content="{Binding [Settings.Theme.Options.Forest]}"/>
                                                    <ComboBoxItem Content="{Binding [Settings.Theme.Options.Mocha]}"/>
                                                    <ComboBoxItem Content="{Binding [Settings.Theme.Options.Slate]}"/>
                                                </ComboBox>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Panel>
                        </TabItem>

                        <TabItem Header="{Binding [Settings.Display]}" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}">
                            <Panel>
                                <ScrollViewer>
                                    <StackPanel Spacing="20" Margin="0,0,10,0">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.RemoveBrackets.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.RemoveBrackets.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                <ToggleSwitch x:Name="SettingsOverlay_RemoveBracketsCheckBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.IconSize.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.IconSize.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,30" ColumnSpacing="5">
                                                <Slider x:Name="SettingsOverlay_NormalIconSizeSlider" Value="70" Minimum="0" Maximum="200" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                <TextBlock Grid.Column="1" Text="{Binding #SettingsOverlay_NormalIconSizeSlider.Value, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.EnableHoverIcon.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.EnableHoverIcon.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                <ToggleSwitch x:Name="SettingsOverlay_EnableHoverIconSizeCheckBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding #SettingsOverlay_EnableHoverIconSizeCheckBox.IsChecked}">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.HoverIconSize.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.HoverIconSize.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,30" ColumnSpacing="5">
                                                <Slider x:Name="SettingsOverlay_HoverIconSizeSlider" Value="200" Minimum="0" Maximum="800" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                <TextBlock Grid.Column="1" Text="{Binding #SettingsOverlay_HoverIconSizeSlider.Value, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.AntiAliasing.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.AntiAliasing.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,2.5*" ColumnSpacing="5">
                                                <ComboBox Grid.Column="1" x:Name="SettingsOverlay_AntiAliasingModeComboBox" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                    <ComboBoxItem Content="{Binding [Settings.AntiAliasing.Options.None]}"/>
                                                    <ComboBoxItem Content="{Binding [Settings.AntiAliasing.Options.Low]}"/>
                                                    <ComboBoxItem Content="{Binding [Settings.AntiAliasing.Options.Medium]}"/>
                                                    <ComboBoxItem Content="{Binding [Settings.AntiAliasing.Options.High]}"/>
                                                </ComboBox>
                                            </Grid>
                                        </Grid>
                                        
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.ItemsPerPage.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.ItemsPerPage.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,2.5*" ColumnSpacing="5">
                                                <TextBox Grid.Column="1" x:Name="SettingsOverlay_ItemsPerPageTextBox" Text="30" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Panel>
                        </TabItem>

                        <TabItem Header="{Binding [Settings.Item]}" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}">
                            <Panel>
                                <ScrollViewer>
                                    <StackPanel Spacing="20" Margin="0,0,10,0">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.RemoveOriginal.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.RemoveOriginal.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                <ToggleSwitch x:Name="SettingsOverlay_RemoveOriginalCheckBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.LinkToOriginal.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.LinkToOriginal.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                <ToggleSwitch x:Name="SettingsOverlay_LinkToOriginalCheckBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.TreatEmptySupportedAvatarAsNone.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.TreatEmptySupportedAvatarAsNone.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                <ToggleSwitch x:Name="SettingsOverlay_TreatEmptySupportedAvatarAsNoneCheckBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.ThumbnailCompressionMaxSize.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.ThumbnailCompressionMaxSize.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,45" ColumnSpacing="5">
                                                <Slider x:Name="SettingsOverlay_ThumbnailCompressionMaxSizeSlider" Value="256" Minimum="64" Maximum="1024" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                <TextBlock Grid.Column="1" Text="{Binding #SettingsOverlay_ThumbnailCompressionMaxSizeSlider.Value, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Panel>
                        </TabItem>

                        <TabItem Header="{Binding [Settings.Background]}" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}">
                            <Panel>
                                <ScrollViewer>
                                    <StackPanel Spacing="20" Margin="0,0,10,0">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.UseCustomBackground.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.UseCustomBackground.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                <ToggleSwitch x:Name="SettingsOverlay_UseBackgroundImageCheckBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding #SettingsOverlay_UseBackgroundImageCheckBox.IsChecked}">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.BackgroundImage.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.BackgroundImage.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                <TextBox x:Name="SettingsOverlay_BackgroundImagePathTextBox" IsReadOnly="True" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                <Button Classes="button" Grid.Column="1" Content="{Binding [Settings.BackgroundImage.Browse]}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Click="SettingsOverlay_OpenBackgroundFile_Click"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding #SettingsOverlay_UseBackgroundImageCheckBox.IsChecked}">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.Opacity.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.Opacity.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,30" ColumnSpacing="5">
                                                <Slider x:Name="SettingsOverlay_BackgroundImageOpacitySlider" Value="20" Minimum="0" Maximum="100" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                <TextBlock Grid.Column="1" Text="{Binding #SettingsOverlay_BackgroundImageOpacitySlider.Value, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Panel>
                        </TabItem>

                        <TabItem Header="{Binding [Settings.CommonAvatar]}" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}">
                            <Panel>
                                <ScrollViewer>
                                    <StackPanel Spacing="20" Margin="0,0,10,0">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.CommonAvatarManagement.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.CommonAvatarManagement.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <Button Grid.Column="1" Classes="accentbutton" Content="{Binding [Settings.CommonAvatarManagement.OpenManagement]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="SettingsOverlay_EditCommonAvatars_Click"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Panel>
                        </TabItem>

                        <TabItem Header="{Binding [Settings.Data]}" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}">
                            <Panel>
                                <ScrollViewer>
                                    <StackPanel Spacing="20" Margin="0,0,10,0">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.ItemsFolder.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.ItemsFolder.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                <TextBox x:Name="SettingsOverlay_ItemsFolderPathTextBox" IsReadOnly="True" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                <Button Classes="button" Grid.Column="1" Content="{Binding [Settings.ItemsFolder.Browse]}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Click="SettingsOverlay_OpenFolder_Click"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.AutoBackupPath.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.AutoBackupPath.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                <TextBox x:Name="SettingsOverlay_AutoBackupPathTextBox" IsReadOnly="True" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                <Button Classes="button" Grid.Column="1" Content="{Binding [Settings.AutoBackupPath.Browse]}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Click="SettingsOverlay_OpenAutoBackupRootFolder_Click"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.AutoBackupInterval.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.AutoBackupInterval.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <TextBox Grid.Column="1" x:Name="SettingsOverlay_AutoBackupIntervalTextBox" Text="5" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.ImportFromOther.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.ImportFromOther.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <Button Grid.Column="1" Classes="accentbutton" Content="{Binding [Settings.ImportFromOther.Import]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="SettingsOverlay_ImportData_Click"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.ExportCsv.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.ExportCsv.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <Button Grid.Column="1" Classes="accentbutton" Content="{Binding [Settings.ExportCsv.Export]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="SettingsOverlay_ExportDataToCsv_Click"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.ImportThumbnail.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.ImportThumbnail.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <Button Grid.Column="1" Classes="accentbutton" Content="{Binding [Settings.ImportThumbnail.Import]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="SettingsOverlay_ImportThumbnail_Click"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.RestoreFromBackup.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.RestoreFromBackup.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <Button Grid.Column="1" Classes="accentbutton" Content="{Binding [Settings.RestoreFromBackup.SelectBackup]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="SettingsOverlay_RestoreDataFromBackup_Click"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.ResetItemDatabase.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.ResetItemDatabase.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <Button Grid.Column="1" Classes="accentbutton" FontWeight="Bold" Content="{Binding [Settings.ResetItemDatabase.Reset]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="SettingsOverlay_ResetItemDatabase_Click"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.ResetCommonAvatarDatabase.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.ResetCommonAvatarDatabase.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <Button Grid.Column="1" Classes="accentbutton" FontWeight="Bold" Content="{Binding [Settings.ResetCommonAvatarDatabase.Reset]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="SettingsOverlay_ResetCommonAvatarDatabase_Click"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.ResetBulkImportPresetDatabase.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.ResetBulkImportPresetDatabase.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <Button Grid.Column="1" Classes="accentbutton" FontWeight="Bold" Content="{Binding [Settings.ResetBulkImportPresetDatabase.Reset]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="SettingsOverlay_ResetBulkImportPresetDatabase_Click"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Panel>
                        </TabItem>

                        <TabItem Header="{Binding [Settings.System]}" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}">
                            <Panel>
                                <ScrollViewer>
                                    <StackPanel Spacing="20" Margin="0,0,10,0">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.ErrorLog.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.ErrorLog.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <Button Grid.Column="1" Classes="accentbutton" Content="{Binding [Settings.ErrorLog.OpenErrorLog]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="SettingsOverlay_ShowErrorLog_Click"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.RegisterScheme.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.RegisterScheme.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <Button Grid.Column="1" Classes="accentbutton" Content="{Binding [Settings.RegisterScheme.Register]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="SettingsOverlay_RegisterScheme_Click"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.MaxDegreeOfParallelism.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.MaxDegreeOfParallelism.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <TextBox Grid.Column="1" x:Name="SettingsOverlay_MaxDegreeOfParallelismTextBox" Text="5" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.CheckForUpdate.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.CheckForUpdate.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                <ToggleSwitch x:Name="SettingsOverlay_CheckForUpdateCheckBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>
                                        
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding #SettingsOverlay_CheckForUpdateCheckBox.IsChecked}">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.UpdateChannel.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.UpdateChannel.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,2.5*" ColumnSpacing="5">
                                                <ComboBox Grid.Column="1" x:Name="SettingsOverlay_UpdateChannelComboBox" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                    <ComboBoxItem Content="{Binding [Settings.UpdateChannel.Options.Stable]}"/>
                                                    <ComboBoxItem Content="{Binding [Settings.UpdateChannel.Options.Beta]}"/>
                                                </ComboBox>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="{Binding [Settings.CheckForUpdateNow.Title]}"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="{Binding [Settings.CheckForUpdateNow.Description]}"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <Button Grid.Column="1" Classes="accentbutton" Content="{Binding [Settings.CheckForUpdateNow.Check]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="SettingsOverlay_UpdateCheckNow_Click"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Panel>
                        </TabItem>

                        <TabItem FontWeight="Bold">
                            <TabItem.Header>
                                <StackPanel Spacing="8" Orientation="Horizontal">
                                    <materialIcons:MaterialIcon Kind="InformationOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [Settings.About]}" FontSize="16" Foreground="{DynamicResource Text.Primary}"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <Panel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="25" Margin="20">
                                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding [Settings.AboutInfo.Title]}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                                            <TextBlock Text="{Binding [Settings.AboutInfo.Subtitle]}" TextAlignment="Center" FontSize="14" Foreground="{DynamicResource Text.Secondary}"/>
                                        </StackPanel>

                                        <Separator Classes="separator"/>
                                        
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="30">
                                            <StackPanel Grid.Column="0" Spacing="15">
                                                
                                                <TextBlock Text="{Binding [Settings.AboutDeveloper.Title]}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>

                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Grid Grid.Column="0">
                                                        <Border HorizontalAlignment="Center" Width="100" Height="100" CornerRadius="50" ClipToBounds="True">
                                                            <Image x:Name="SettingsOverlay_DeveloperProfileImage" Stretch="UniformToFill"/>
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" Spacing="10">
                                                        <StackPanel Spacing="5">
                                                            <TextBlock Text="{Binding [Settings.AboutDeveloper.Label]}" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
                                                            <TextBlock Text="ぷこるふ" FontSize="14" Foreground="{DynamicResource Text.Primary}"/>
                                                        </StackPanel>

                                                        <Button Classes="button" Padding="10,6" CornerRadius="6" Click="SettingsOverlay_OpenTwitter_Click">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <materialIcons:MaterialIcon Kind="Twitter" Width="16" Height="16"/>
                                                                <TextBlock Text="Twitter" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Text.Primary}"/>
                                                            </StackPanel>
                                                        </Button>

                                                        <Button Classes="button" Padding="10,6" CornerRadius="6" Click="SettingsOverlay_OpenGithub_Click">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <materialIcons:MaterialIcon Kind="Github" Width="16" Height="16"/>
                                                                <TextBlock Text="Github" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Text.Primary}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="15">
                                                <TextBlock Text="{Binding [Settings.AboutProject.Title]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>

                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="{Binding [Settings.AboutProject.SourceCodeDescription]}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" />
                                                    <Button Classes="button" Padding="10,6" CornerRadius="6" Click="SettingsOverlay_OpenSourceCode_Click">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <materialIcons:MaterialIcon Kind="Github" Width="16" Height="16"/>
                                                            <TextBlock Text="{Binding [Settings.AboutProject.ViewRepository]}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Text.Primary}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <Separator Classes="separator"/>

                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{Binding [Settings.AboutLicense.Title]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                                            <TextBlock Text="{Binding [Settings.AboutLicense.Type]}" FontSize="13" Foreground="{DynamicResource Text.Primary}"/>
                                            <TextBlock Text="{Binding [Settings.AboutLicense.Description]}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Text.Secondary}"/>
                                        </StackPanel>

                                        <Button Classes="button" Padding="10,8" CornerRadius="8" HorizontalAlignment="Stretch" FontWeight="SemiBold" Click="SettingsOverlay_ViewLicenses_Click">
                                            <TextBlock Text="{Binding [Settings.AboutLicense.ViewLicense]}" Foreground="{DynamicResource Text.Primary}"/>
                                        </Button>

                                        <Button Classes="button" Padding="10,8" CornerRadius="8" HorizontalAlignment="Stretch" FontWeight="SemiBold" Click="SettingsOverlay_ThirdPartyLicenses_Click">
                                            <TextBlock Text="{Binding [Settings.AboutLicense.ViewThirdParty]}" Foreground="{DynamicResource Text.Primary}"/>
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>
                            </Panel>
                        </TabItem>
                    </TabControl>

                    <!-- 下のボタン -->
                    <Grid Grid.Row="2" ColumnDefinitions="200,*,200" Margin="10,20,10,0">
                        <Button Classes="button" FontWeight="Bold" CornerRadius="20" Grid.Column="0" Content="{Binding [Button.Close]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="15" Padding="10" Click="SettingsOverlay_Close_Click" />
                        <Button Classes="accentbutton" FontWeight="Bold" CornerRadius="20" Grid.Column="2" Content="{Binding [Settings.Apply]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="15" Padding="10" Click="SettingsOverlay_Apply_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- アイテム追加画面 -->
        <Border x:Name="AddItemOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30" CornerRadius="12">
                <Grid ColumnDefinitions="350,500" Height="550" ColumnSpacing="20">
                    <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="15">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Classes="accentbutton" FontSize="12" Click="AddItemOverlay_AddFolder_Click">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="FolderPlus" Width="20" Height="20"/>
                                    <TextBlock Text="{Binding [AddItem.AddFolder]}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="accentbutton" FontSize="12" Click="AddItemOverlay_AddFile_Click">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="FilePlus" Width="20" Height="20"/>
                                    <TextBlock Text="{Binding [AddItem.AddFile]}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Grid.Row="1" Classes="panelbackground" Background="{DynamicResource Background.Surface}">
                            <ScrollViewer>
                                <Grid x:Name="AddItemOverlay_ItemPathsList"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Boothアイテム情報 -->
                    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="25">
                        <TextBlock Grid.Row="0" Text="{Binding [AddItem.BoothItemInfo]}" FontWeight="Bold" FontSize="22" Foreground="{DynamicResource Text.Primary}"/>

                        <ScrollViewer Grid.Row="1">
                            <StackPanel Spacing="15" Margin="10">
                                <StackPanel Spacing="15">
                                    <Grid ColumnDefinitions="100,*,120" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Text="{Binding [AddItem.BoothUrl]}" VerticalAlignment="Center" Opacity="0.7" Foreground="{DynamicResource Text.Primary}"/>
                                        <TextBox x:Name="AddItemOverlay_BoothLinkTextBox" Grid.Column="1" PlaceholderText="{Binding [AddItem.BoothUrlPlaceholder]}"/>
                                        <Button Grid.Column="2" Classes="accentbutton" Content="{Binding [AddItem.FetchInfo]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="AddItemOverlay_GetBoothItemData_Click"/>
                                    </Grid>

                                    <Separator Classes="separator"/>

                                    <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Text="{Binding [AddItem.Title]}" VerticalAlignment="Center" Opacity="0.7" Foreground="{DynamicResource Text.Primary}"/>
                                        <TextBox x:Name="AddItemOverlay_BoothItemTitleTextBox" Grid.Column="1" PlaceholderText="{Binding [AddItem.Title]}"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Text="{Binding [AddItem.Author]}" VerticalAlignment="Center" Opacity="0.7" Foreground="{DynamicResource Text.Primary}"/>
                                        <TextBox x:Name="AddItemOverlay_BoothItemAuthorTextBox" Grid.Column="1" PlaceholderText="{Binding [AddItem.Author]}"/>
                                    </Grid>
                                </StackPanel>

                                <UniformGrid Columns="2">
                                    <StackPanel Spacing="8" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding [AddItem.Category]}" FontSize="13" Opacity="0.7" Foreground="{DynamicResource Text.Primary}"/>
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="5">
                                            <ComboBox x:Name="AddItemOverlay_ItemTypeComboBox" HorizontalAlignment="Stretch" SelectedIndex="0"/>
                                            <Button Grid.Column="1" Classes="button" Content="{materialIcons:MaterialIconExt Kind=TabPlus}" Width="35" FontSize="19" Click="AddItemOverlay_AddCustomCategory_Click"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="8" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding [AddItem.SupportedAvatars]}" FontSize="13" Opacity="0.7" Foreground="{DynamicResource Text.Primary}"/>
                                        <Button x:Name="AddItemOverlay_EditSupportedAvatarsButton" Classes="accentbutton" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Click="AddItemOverlay_EditSupportedAvatars_Click"/>
                                    </StackPanel>
                                </UniformGrid>

                                <StackPanel Spacing="10">
                                    <CheckBox Content="{Binding [AddItem.ShowAdvancedSettings]}" FontSize="13" x:Name="AddItemOverlay_ShowAdvancedSettingsCheckBox"/>

                                    <StackPanel IsVisible="{Binding #AddItemOverlay_ShowAdvancedSettingsCheckBox.IsChecked}">
                                        <UniformGrid Columns="2">
                                            <StackPanel Spacing="8" Margin="0,0,0,0">
                                                <TextBlock Text="{Binding [AddItem.ItemMemo]}" FontSize="13" Opacity="0.7" Foreground="{DynamicResource Text.Primary}"/>
                                                <Button Content="{Binding [AddItem.EditItemMemo]}" Classes="button" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Click="AddItemOverlay_EditItemMemo_Click"/>
                                            </StackPanel>

                                            <StackPanel Spacing="8" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding [AddItem.Tags]}" FontSize="13" Opacity="0.7" Foreground="{DynamicResource Text.Primary}"/>
                                                <Button x:Name="AddItemOverlay_EditTagsButton" Classes="button" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Click="AddItemOverlay_EditTags_Click"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </StackPanel>

                                <Separator Classes="separator" Height="1"/>

                                <StackPanel Spacing="10">
                                    <CheckBox x:Name="AddItemOverlay_ShowInternalInfo" Content="{Binding [AddItem.ShowInternalInfo]}" FontSize="13"/>
                                    
                                    <StackPanel IsVisible="{Binding #AddItemOverlay_ShowInternalInfo.IsChecked}" Spacing="12" Margin="10,5,0,0">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                                            <StackPanel Grid.Column="0" Spacing="5">
                                                <TextBlock Text="{Binding [AddItem.AuthorId]}" FontSize="12" Opacity="0.6" Foreground="{DynamicResource Text.Primary}"/>
                                                <TextBox x:Name="AddItemOverlay_InternalAuthorIdTextBox" FontSize="13"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <TextBlock Text="{Binding [AddItem.BoothId]}" FontSize="12" Opacity="0.6" Foreground="{DynamicResource Text.Primary}"/>
                                                <TextBox x:Name="AddItemOverlay_InternalBoothIdTextBox" FontSize="13"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding [AddItem.ImageUrl]}" FontSize="12" Opacity="0.6" Foreground="{DynamicResource Text.Primary}"/>
                                            <TextBox x:Name="AddItemOverlay_InternalImageURLTextBox" FontSize="13"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="15" Margin="0,10,0,0">
                            <Button Grid.Column="1" Content="{Binding [Button.Cancel]}" Width="160" Height="40" Classes="button" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="AddItemOverlay_Close_Click" />
                            <Button Grid.Column="2" Content="{Binding [AddItem.ConfirmAndSave]}" Width="160" Height="40" Classes="accentbutton" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="AddItemOverlay_Confirm_Click"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- 対応アバター編集画面 -->
        <Border x:Name="EditSupportedAvatarsOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="800">
                <StackPanel Spacing="10">
                    <Grid RowDefinitions="Auto,20,Auto,10,Auto,20,Auto">

                        <!-- タイトル -->
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="{Binding [EditSupportedAvatars.Title]}" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                        
                        <!-- 検索バー -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox x:Name="EditSupportedAvatarsOverlay_SearchTextBox" Grid.Column="0" PlaceholderText="{Binding [EditSupportedAvatars.Search]}" TextChanged="EditSupportedAvatarsOverlay_SearchTextBox_TextChanged"/>
                            <Button Grid.Column="1" Classes="button" Content="{Binding [Button.SelectVisible]}" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="12,6" Click="EditSupportedAvatarsOverlay_SelectVisible_Click"/>
                        </Grid>

                        <!-- アバターリスト -->
                        <ScrollViewer Grid.Row="4" Height="500">
                            <StackPanel x:Name="EditSupportedAvatarsOverlay_AvatarsList" Spacing="8" Margin="0,0,10,0"/>
                        </ScrollViewer>

                        <!-- 下のボタン -->
                        <Grid ColumnDefinitions="200,*,150,150" Grid.Row="6" Margin="10,0,10,0" ColumnSpacing="20">
                            <Button Classes="button" FontWeight="Bold" Grid.Column="0" Content="{Binding [EditSupportedAvatars.AddTempAvatar]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="EditSupportedAvatarsOverlay_AddTempAvatar_Click"/>
                            <Button Classes="button" FontWeight="Bold" Grid.Column="2" Content="{Binding [Button.Cancel]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="EditSupportedAvatarsOverlay_Cancel_Click"/>
                            <Button Classes="accentbutton" FontWeight="Bold" Grid.Column="3" Content="{Binding [Button.Confirm]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="EditSupportedAvatarsOverlay_Confirm_Click"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- 実装アバター編集画面 -->
        <Border x:Name="EditImplementedAvatarsOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="800">
                <StackPanel Spacing="10">
                    <Grid RowDefinitions="Auto,20,Auto,10,Auto,20,Auto">

                        <!-- タイトル -->
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="{Binding [EditImplementedAvatars.Title]}" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                        
                        <!-- 検索バー -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox x:Name="EditImplementedAvatarsOverlay_SearchTextBox" Grid.Column="0" PlaceholderText="{Binding [EditSupportedAvatars.Search]}" TextChanged="EditImplementedAvatarsOverlay_SearchTextBox_TextChanged"/>
                            <Button Grid.Column="1" Classes="button" Content="{Binding [Button.SelectVisible]}" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="12,6" Click="EditImplementedAvatarsOverlay_SelectVisible_Click"/>
                        </Grid>

                        <!-- アバターリスト -->
                        <ScrollViewer Grid.Row="4" Height="500">
                            <StackPanel x:Name="EditImplementedAvatarsOverlay_AvatarsList" Spacing="8" Margin="0,0,10,0"/>
                        </ScrollViewer>

                        <!-- 下のボタン -->
                        <Grid ColumnDefinitions="*,180,180" Grid.Row="6" Margin="10,0,10,0" ColumnSpacing="20">
                            <Button Classes="button" FontWeight="Bold" Grid.Column="1" Content="{Binding [Button.Cancel]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="EditImplementedAvatarsOverlay_Cancel_Click"/>
                            <Button Classes="accentbutton" FontWeight="Bold" Grid.Column="2" Content="{Binding [Button.Confirm]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="EditImplementedAvatarsOverlay_Confirm_Click"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- 仮アバター解決画面 -->
        <Border x:Name="ResolveTempAvatarOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="800">
                <StackPanel Spacing="10">
                    <Grid RowDefinitions="Auto,20,Auto,10,Auto,20,Auto">

                        <!-- タイトル -->
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="{Binding [ResolveTempAvatar.Title]}" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                        
                        <!-- 検索バー -->
                        <TextBox x:Name="ResolveTempAvatarOverlay_SearchTextBox" Grid.Row="2" PlaceholderText="{Binding [ResolveTempAvatar.Search]}" TextChanged="ResolveTempAvatarOverlay_SearchTextBox_TextChanged"/>

                        <!-- アバターリスト -->
                        <ScrollViewer Grid.Row="4" Height="500">
                            <StackPanel x:Name="ResolveTempAvatarOverlay_AvatarsList" Spacing="8" Margin="0,0,10,0"/>
                        </ScrollViewer>

                        <Grid ColumnDefinitions="*,180" Grid.Row="6" Margin="10,0,10,0" ColumnSpacing="20">
                            <Button Classes="button" FontWeight="Bold" Grid.Column="1" Content="{Binding [Button.Cancel]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="ResolveTempAvatarOverlay_Cancel_Click"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- 共通素体アバター編集画面 -->
        <Border x:Name="EditCommonAvatarsOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="800">
                <StackPanel Spacing="10">
                    <Grid RowDefinitions="Auto,20,Auto,30,Auto,10,Auto,20,Auto">

                        <!-- タイトル -->
                        <TextBlock Grid.Row="0" Text="{Binding [EditCommonAvatars.Title]}" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>

                        <!-- グループ選択欄 -->
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="10,0,10,0" Grid.Row="2" ColumnSpacing="10">
                            <TextBlock Text="{Binding [EditCommonAvatars.Group]}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                            <ComboBox x:Name="EditCommonAvatarsOverlay_GroupComboBox" Grid.Column="1" SelectedIndex="0" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Margin="10,0,10,0" SelectionChanged="EditCommonAvatarsOverlay_GroupComboBox_SelectionChanged"/>
                            <Button Classes="button" FontWeight="Bold" Grid.Column="2" Content="{Binding [EditCommonAvatars.AddGroup]}" VerticalAlignment="Center" HorizontalAlignment="Left" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="15" Click="EditCommonAvatarsOverlay_AddGroup_Click"/>
                            <Button Classes="button" FontWeight="Bold" Grid.Column="3" Content="{Binding [EditCommonAvatars.RenameGroup]}" VerticalAlignment="Center" HorizontalAlignment="Left" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="15" Click="EditCommonAvatarsOverlay_RenameGroup_Click"/>
                            <Button Classes="button" FontWeight="Bold" Grid.Column="4" Content="{Binding [EditCommonAvatars.RemoveGroup]}" VerticalAlignment="Center" HorizontalAlignment="Left" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="15" Click="EditCommonAvatarsOverlay_RemoveGroup_Click"/>
                        </Grid>
                        
                        <!-- 検索バー -->
                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox x:Name="EditCommonAvatarsOverlay_SearchTextBox" Grid.Column="0" PlaceholderText="{Binding [EditSupportedAvatars.Search]}" TextChanged="EditCommonAvatarsOverlay_SearchTextBox_TextChanged"/>
                            <Button Grid.Column="1" Classes="button" Content="{Binding [Button.SelectVisible]}" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="12,6" Click="EditCommonAvatarsOverlay_SelectVisible_Click"/>
                        </Grid>

                        <!-- アバターリスト -->
                        <ScrollViewer Grid.Row="6" Height="400">
                            <StackPanel x:Name="EditCommonAvatarsOverlay_AvatarsList" Spacing="8" Margin="0,0,10,0"/>
                        </ScrollViewer>

                        <!-- 下のボタン -->
                        <Grid ColumnDefinitions="Auto,*,180" Grid.Row="8">
                            <Button Classes="button" FontWeight="Bold" Content="{Binding [EditCommonAvatars.ReplaceToGroup]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="10,7" FontSize="15" Click="EditCommonAvatarsOverlay_ReplaceAvatarsToGroup_Click"/>
                            <Button Classes="accentbutton" FontWeight="Bold" Grid.Column="2" Content="{Binding [Button.Close]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="EditCommonAvatarsOverlay_Close_Click"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- アイテムメモ追加画面 -->
        <Border x:Name="EditMemoOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="500">
                <StackPanel Spacing="15">
                    
                    <!-- タイトル -->
                    <TextBlock Text="{Binding [EditMemo.Title]}" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>

                    <!-- メモテキスト -->
                    <TextBox Height="150" x:Name="EditMemoOverlay_MemoTextBox" PlaceholderText="{Binding [EditMemo.Memo]}" AcceptsReturn="True"/>

                    <!-- 下のボタン -->
                    <Grid ColumnDefinitions="150,*,150">
                        <Button Classes="button" FontWeight="Bold" Grid.Column="0" Content="{Binding [Button.Cancel]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="EditMemoOverlay_Cancel_Click"/>
                        <Button Classes="accentbutton" FontWeight="Bold" Grid.Column="2" Content="{Binding [DialogResult.OK]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="EditMemoOverlay_Confirm_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- アイテムタグ編集画面 -->
        <Border x:Name="EditTagsOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="450">
                <StackPanel Spacing="15">

                    <!-- タイトル -->
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="{Binding [EditTags.Title]}" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>

                    <!-- アイテムタグリスト -->
                    <Border Classes="panelbackground" Background="{DynamicResource Background.Surface}" Height="180">
                        <ScrollViewer x:Name="EditTagsOverlay_TagListScrollViewer" Margin="3">
                            <WrapPanel x:Name="EditTagsOverlay_TagList" VerticalAlignment="Stretch" LineSpacing="5" ItemSpacing="5"/>
                        </ScrollViewer>
                    </Border>

                    <!-- タグの追加 -->
                    <TextBlock Text="{Binding [EditTags.AddTag]}" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                        <TextBox x:Name="EditTagsOverlay_TagTextBox" Grid.Column="0" PlaceholderText="{Binding [EditTags.NewTag]}" KeyDown="EditTagsOverlay_TagTextBox_KeyDown"/>
                        <Button Grid.Column="1" Classes="accentbutton" Content="{Binding [EditTags.AddTag]}" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="EditTagsOverlay_AddTagButton_Click"/>
                    </Grid>
                    <ComboBox x:Name="EditTagsOverlay_TagComboBox" PlaceholderText="{Binding [EditTags.SelectTag]}" Grid.Row="8" HorizontalAlignment="Stretch" SelectionChanged="EditTagsOverlay_TagComboBox_SelectionChanged"/>

                    <!-- 下のボタン -->
                    <Grid ColumnDefinitions="150,*,150" Margin="0,10,0,0">
                        <Button Classes="button" FontWeight="Bold" Grid.Column="0" Content="{Binding [Button.Cancel]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="EditTagsOverlay_Cancel_Click"/>
                        <Button Classes="accentbutton" FontWeight="Bold" Grid.Column="2" Content="{Binding [DialogResult.OK]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="EditTagsOverlay_Confirm_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- データインポート画面 -->
        <Border x:Name="SelectImportTypeOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="500" Padding="24">
                <StackPanel Spacing="14">

                    <!-- タイトル -->
                    <TextBlock Text="{Binding [SelectImportType.Title]}" VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" Foreground="{DynamicResource Text.Primary}"/>
                    <Separator Classes="separator"/>
                    
                    <!-- インポートタイプ選択ボタン -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Classes="accentbutton" FontWeight="Bold" Grid.Column="0" Content="{Binding [SelectImportType.Options.V1]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="15" Padding="10" Click="SelectImportTypeOverlay_FromV1_Click"/>
                        <Button Classes="button" FontWeight="Bold" Grid.Column="1" Content="{Binding [SelectImportType.Options.KonoAsset]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="15" Padding="10" Click="SelectImportTypeOverlay_FromKonoAsset_Click"/>
                    </Grid>
                    <Button Classes="button" FontWeight="Bold" Content="{Binding [Button.Close]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="15" Padding="10" Margin="0,2,0,0" Click="SelectImportTypeOverlay_Cancel_Click"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- サムネイルインポート画面 -->
        <Border x:Name="SelectThumbnailImportTypeOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="500" Padding="24">
                <StackPanel Spacing="14">

                    <!-- タイトル -->
                    <TextBlock Text="{Binding [SelectImportType.Title]}" VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" Foreground="{DynamicResource Text.Primary}"/>
                    <Separator Classes="separator"/>

                    <!-- インポートタイプ選択ボタン -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Classes="accentbutton" FontWeight="Bold" Grid.Column="0" Content="{Binding [SelectImportType.Options.V1]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="15" Padding="10" Click="SelectThumbnailImportTypeOverlay_FromV1_Click"/>
                        <Button Classes="button" FontWeight="Bold" Grid.Column="1" Content="{Binding [SelectImportType.Options.KonoAsset]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="15" Padding="10" Click="SelectThumbnailImportTypeOverlay_FromKonoAsset_Click"/>
                    </Grid>
                    <Button Classes="button" FontWeight="Bold" Content="{Binding [Button.Close]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="15" Padding="10" Margin="0,2,0,0" Click="SelectThumbnailImportTypeOverlay_Cancel_Click"/>
                </StackPanel>
            </Border>
        </Border>
        
        <!-- Unitypackage Viewer -->
        <Border x:Name="UnitypackageViewerOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="800" Height="600" Padding="20">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                    <TextBlock Text="Unitypackage Viewer" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                    <StackPanel Grid.Row="1" Spacing="2">
                        <TextBlock x:Name="UnitypackageViewerOverlay_FileName" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
                        <TextBlock x:Name="UnitypackageViewerOverlay_StatusText" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
                        <TextBlock x:Name="UnitypackageViewerOverlay_SelectedPathText" FontSize="12" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border Grid.Row="2" Classes="panelbackground" Background="{DynamicResource Background.Surface}">
                        <ScrollViewer>
                            <TreeView x:Name="UnitypackageViewerOverlay_TreeView" SelectionChanged="UnitypackageViewerOverlay_TreeView_SelectionChanged">
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate x:DataType="ui:MainWindow+UnitypackagePathNode" ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text.Primary}"/>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="3" ColumnDefinitions="*,120,120" ColumnSpacing="10">
                        <Button Grid.Column="1" x:Name="UnitypackageViewerOverlay_ExportButton" Classes="accentbutton" FontWeight="Bold" Content="{Binding [Settings.ExportCsv.Export]}" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="UnitypackageViewerOverlay_Export_Click" IsEnabled="False"/>
                        <Button Grid.Column="2" Classes="button" FontWeight="Bold" Content="{Binding [Button.Close]}" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="UnitypackageViewerOverlay_Close_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- 進捗画面 -->
        <Border x:Name="ProgressOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="400">
                <StackPanel Spacing="20">

                    <!-- タイトル -->
                    <TextBlock x:Name="ProgressOverlay_Title" Text="{Binding [Progress.Loading]}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="17" FontWeight="Bold" Margin="0,5,0,5" Foreground="{DynamicResource Text.Primary}"/>

                    <!-- 進捗バー -->
                    <ProgressBar x:Name="ProgressOverlay_Bar" Value="0" IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Border>
        
        <!-- OKダイアログ -->
        <Border x:Name="DialogOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="500">
                <StackPanel Spacing="15">

                    <!-- タイトル -->
                    <TextBlock x:Name="DialogOverlay_Title" Text="Title" FontSize="24" FontWeight="Bold" HorizontalAlignment="Left" Foreground="{DynamicResource Text.Primary}"/>

                    <!-- 内容 -->
                    <TextBlock x:Name="DialogOverlay_Content" Text="Content" FontSize="17" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,10,0,10" Foreground="{DynamicResource Text.Primary}"/>

                    <!-- OKボタン -->
                    <Button Classes="accentbutton" FontWeight="Bold" Content="{Binding [DialogResult.OK]}" Width="150" VerticalAlignment="Center" HorizontalAlignment="Right" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="DialogOverlay_OK_Click"/>
                </StackPanel>
            </Border>
        </Border>
        
        <!-- テキストダイアログ -->
        <Border x:Name="TextDialogOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="500">
                <StackPanel Spacing="15">
                    
                    <!-- タイトル -->
                    <TextBlock x:Name="TextDialogOverlay_Title" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>

                    <!-- テキスト -->
                    <TextBox x:Name="TextDialogOverlay_Content" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,10,0,10" Foreground="{DynamicResource Text.Primary}"/>

                    <!-- 下のボタン -->
                    <Grid ColumnDefinitions="150,*,150">
                        <Button Classes="button" FontWeight="Bold" Grid.Column="0" Content="{Binding [Button.Cancel]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="TextDialogOverlay_Cancel_Click"/>
                        <Button Classes="accentbutton" FontWeight="Bold" Grid.Column="2" Content="{Binding [Button.Confirm]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="TextDialogOverlay_Confirm_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- アーカイブパスワード入力ダイアログ -->
        <Border x:Name="ArchivePasswordDialogOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="500" Padding="20">
                <StackPanel Spacing="15">
                    
                    <!-- タイトル + ファイル名 + 試行回数 -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding [ArchivePasswordDialog.Title]}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock x:Name="ArchivePasswordDialogOverlay_FileName" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
                        <TextBlock x:Name="ArchivePasswordDialogOverlay_AttemptInfo" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
                    </StackPanel>

                    <Separator Classes="separator"/>

                    <!-- パスワード説明 -->
                    <TextBlock Text="{Binding [ArchivePasswordDialog.Description]}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}"/>
                    
                    <!-- パスワード入力欄 -->
                    <TextBox x:Name="ArchivePasswordDialogOverlay_PasswordBox" PasswordChar="●" PlaceholderText="{Binding [ArchivePasswordDialog.Placeholder]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="10,10,10,10" FontSize="14"/>

                    <!-- 下のボタン -->
                    <Grid ColumnDefinitions="150,*,150">
                        <Button Classes="button" FontWeight="Bold" Grid.Column="0" Content="{Binding [Button.Cancel]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="ArchivePasswordDialogOverlay_Cancel_Click"/>
                        <Button Classes="accentbutton" FontWeight="Bold" Grid.Column="2" Content="{Binding [Button.Confirm]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="ArchivePasswordDialogOverlay_Confirm_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Yes/Noダイアログ -->
        <Border x:Name="YesNoDialogOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="500">
                <StackPanel Spacing="15">

                    <!-- タイトル -->
                    <TextBlock x:Name="YesNoDialogOverlay_Title" FontSize="24" FontWeight="Bold" HorizontalAlignment="Left" Foreground="{DynamicResource Text.Primary}"/>

                    <!-- 内容 -->
                    <TextBlock x:Name="YesNoDialogOverlay_Content" FontSize="17" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,10,0,10" Foreground="{DynamicResource Text.Primary}"/>
                    
                    <!-- Yes/Noボタン -->
                    <Grid ColumnDefinitions="100,*,100">
                        <Button Classes="button" FontWeight="Bold" Grid.Column="0" Content="{Binding [DialogResult.No]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="YesNoDialogOverlay_No_Click"/>
                        <Button Classes="accentbutton" FontWeight="Bold" Grid.Column="2" Content="{Binding [DialogResult.Yes]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="YesNoDialogOverlay_Yes_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- アップデートダイアログ -->
        <Border x:Name="UpdateDialogOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="500" Padding="20">
                <StackPanel Spacing="15">

                    <!-- タイトル + バージョンテキスト -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding [UpdateDialog.Available]}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock x:Name="UpdateDialogOverlay_VersionText" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
                    </StackPanel>

                    <Separator Classes="separator"/>

                    <!-- 更新履歴 -->
                    <TextBlock Text="{Binding [UpdateDialog.ChangeLogs]}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"/>
                    <Border Classes="panelbackground" Height="200" Background="{DynamicResource Background.Surface}">
                        <ScrollViewer>
                            <TextBlock x:Name="UpdateDialogOverlay_UpdateContentText" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource Text.Primary}"/>
                        </ScrollViewer>
                    </Border>

                    <!-- 下のボタン -->
                    <Grid ColumnDefinitions="*,10,120,10,120">
                        <Button Grid.Column="2" Classes="button" Content="{Binding [UpdateDialog.Later]}" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="UpdateDialogOverlay_Later_Click"/>
                        <Button Grid.Column="4" Classes="accentbutton" Content="{Binding [UpdateDialog.UpdateNow]}" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="UpdateDialogOverlay_UpdateNow_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- カテゴリ統合ダイアログ -->
        <Border x:Name="MergeCategoryOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="500">
                <StackPanel Spacing="15">

                    <!-- タイトル -->
                    <TextBlock Text="{Binding [MergeCategory.Title]}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Left" Foreground="{DynamicResource Text.Primary}"/>

                    <!-- 統合先のカテゴリ -->
                    <StackPanel Spacing="8" Margin="0,10,0,10">
                        <TextBlock Text="{Binding [MergeCategory.TargetCategory]}" FontSize="13" Opacity="0.7" Foreground="{DynamicResource Text.Secondary}"/>
                        <ComboBox x:Name="MergeCategoryOverlay_ItemTypeComboBox" HorizontalAlignment="Stretch" SelectedIndex="0"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="100,*,100">
                        <Button Classes="button" FontWeight="Bold" Grid.Column="0" Content="{Binding [Button.Cancel]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="MergeCategoryOverlay_Cancel_Click"/>
                        <Button Classes="accentbutton" FontWeight="Bold" Grid.Column="2" Content="{Binding [MergeCategory.Merge]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="MergeCategoryOverlay_Merge_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- 初期設定オーバーレイ -->
        <Border x:Name="InitialSetupOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="450" Padding="25">
                <StackPanel Spacing="20">

                    <StackPanel Spacing="5">
                        <TextBlock Text="初期設定 / Initial Setup" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock Text="{Binding [InitialSetup.ChangeLaterNotice]}" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
                    </StackPanel>

                    <Separator Classes="separator"/>

                    <StackPanel Spacing="20">
                        <StackPanel Spacing="5">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding [Settings.Language.Title]}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                                    <materialIcons:MaterialIcon Kind="Translate" HorizontalAlignment="Center" Width="30" Height="30" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{Binding [Settings.Language.Description]}" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}"/>
                            </StackPanel>
                            <ComboBox x:Name="InitialSetupOverlay_LanguageComboBox" HorizontalAlignment="Stretch" SelectionChanged="InitialSetupOverlay_LanguageComboBox_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding [Settings.ItemsFolder.Title]}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                                    <materialIcons:MaterialIcon Kind="Folder" HorizontalAlignment="Center" Width="30" Height="30" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{Binding [Settings.ItemsFolder.Description]}" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                <TextBox Grid.Column="0" x:Name="InitialSetupOverlay_ItemsFolderPathTextBox" IsReadOnly="True" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                <Button Classes="button" Grid.Column="1" Content="{Binding [Settings.ItemsFolder.Browse]}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Click="InitialSetupOverlay_OpenFolder_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,120">
                        <Button Grid.Column="1" Classes="accentbutton" Content="{Binding [DialogResult.OK]}" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="InitialSetupOverlay_OK_Click"/>
                    </Grid>

                </StackPanel>
            </Border>
        </Border>

        <!-- エラーログオーバーレイ -->
        <Border x:Name="ErrorLogOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="900" Height="600" Padding="20">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="15">

                    <!-- タイトル -->
                    <TextBlock Text="{Binding [ErrorLog.Title]}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>

                    <Separator Classes="separator" Grid.Row="1"/>

                    <Panel Grid.Row="2">
                        <ScrollViewer>
                            <DataGrid x:Name="ErrorLogOverlay_ErrorLogGrid" GridLinesVisibility="All" x:DataType="common:ErrorContext">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Date, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}"/>
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                    <DataGridTextColumn Header="Tag" Binding="{Binding Tag}"/>
                                </DataGrid.Columns>

                                <DataGrid.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="TextWrapping" Value="WrapWithOverflow"/>
                                    </Style>
                                </DataGrid.Styles>
                            </DataGrid>
                        </ScrollViewer>
                    </Panel>

                    <!-- 下のボタン -->
                    <Grid Grid.Row="3" ColumnDefinitions="120,*,200,120" ColumnSpacing="20">
                        <Button Classes="button" FontWeight="Bold" Grid.Column="0" Content="{Binding [Button.Close]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="ErrorLogOverlay_Close_Click"/>
                        <Button Classes="button" FontWeight="Bold" Grid.Column="2" Content="{Binding [ErrorLog.OpenLogFolder]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="ErrorLogOverlay_OpenLogFolder_Click"/>
                        <Button Classes="accentbutton" FontWeight="Bold" Grid.Column="3" Content="{Binding [ErrorLog.Reflesh]}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="ErrorLogOverlay_Reflesh_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- 致命的なエラーオーバーレイ -->
        <Border x:Name="FatalErrorOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="520" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="FatalErrorOverlay_Title" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource Text.Primary}"/>
                    <TextBlock x:Name="FatalErrorOverlay_Content" FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"/>
                    <TextBlock FontSize="12" Opacity="0.8" Text="The application will close automatically." Foreground="{DynamicResource Text.Secondary}"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- 起動時読み込み画面 -->
        <Grid x:Name="StartupLoadingOverlay" IsVisible="True" Background="#F3EEE6">
            <Grid>
                <Ellipse Width="360" Height="360" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-110,-110,0,0" Fill="#E8D9C7" Opacity="0.32"/>
                <Ellipse Width="240" Height="240" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-80" Fill="#D9E5DC" Opacity="0.35"/>
            </Grid>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" Padding="32" CornerRadius="28" Background="#FFFDF9" BorderBrush="#E0D4C6" BorderThickness="1">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="36" Background="#E9D7C1" HorizontalAlignment="Center">
                        <TextBlock Text="AE" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#5B4B3E"/>
                    </Border>

                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="Avatar Explorer" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#4B3F35"/>
                        <TextBlock Text="Loading your library and preferences..." FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Foreground="#7B6B5E"/>
                    </StackPanel>

                    <ProgressBar Width="320" Height="8" IsIndeterminate="True" Foreground="#B98F6F" Background="#E8DDD2"/>

                    <TextBlock Text="Please wait a moment." FontSize="12" HorizontalAlignment="Center" Foreground="#8B7A6A"/>
                </StackPanel>
            </Border>
        </Grid>
    </Panel>
</Window>
