<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AvatarExplorer.UI.ViewModels.Panels"
    xmlns:loc="using:AvatarExplorer.UI.Localization"
    xmlns:vmmain="using:AvatarExplorer.UI.ViewModels"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:Class="AvatarExplorer.UI.Views.Panels.BoothFiles"
    x:DataType="vm:BoothFilesViewModel">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" VerticalAlignment="Stretch" Margin="6,0,0,0">
        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="5" Margin="10,0">
            <TextBlock Text="{Binding [SidePanel.BoothFiles], Source={x:Static loc:Localizer.Instance}}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
            <Button Grid.Column="1" Classes="button" Width="28" Height="28" CornerRadius="6" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{Binding [BoothFiles.Info.Title], Source={x:Static loc:Localizer.Instance}}"
                    ToolTip.FontFamily="{Binding FontFamily, Source={x:Static vmmain:MainWindowViewModel.Instance}}"
                    AutomationProperties.Name="{Binding [BoothFiles.Info.Title], Source={x:Static loc:Localizer.Instance}}">
                <materialIcons:MaterialIcon Kind="InformationOutline" Width="18" Height="18"/>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="info">
                        <LayoutTransformControl>
                            <LayoutTransformControl.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding UiScale, Source={x:Static vmmain:MainWindowViewModel.Instance}}" ScaleY="{Binding UiScale, Source={x:Static vmmain:MainWindowViewModel.Instance}}"/>
                            </LayoutTransformControl.LayoutTransform>
                            <StackPanel Spacing="10" MaxWidth="320" Margin="16">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <materialIcons:MaterialIcon Kind="InformationOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [BoothFiles.Info.Title], Source={x:Static loc:Localizer.Instance}}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding [BoothFiles.Info.Description], Source={x:Static loc:Localizer.Instance}}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{DynamicResource Text.Primary}"/>
                                <Border Background="{DynamicResource Background.Window}" BorderBrush="{DynamicResource Panel.BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <TextBlock Text="{Binding [BoothFiles.Info.Note], Source={x:Static loc:Localizer.Instance}}" TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{DynamicResource Text.Secondary}"/>
                                </Border>
                            </StackPanel>
                        </LayoutTransformControl>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Separator Classes="separator" Grid.Row="1"/>

        <StackPanel Grid.Row="2" IsVisible="{Binding !HasBoothItem}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="20">
            <materialIcons:MaterialIcon Kind="FileOutline" Width="44" Height="44" Opacity="0.35" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding [BoothFiles.SelectItem], Source={x:Static loc:Localizer.Instance}}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Text.Secondary}"/>
        </StackPanel>

        <Grid Grid.Row="2" IsVisible="{Binding HasBoothItem}" RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="4,0,8,0">
            <StackPanel Spacing="8" Margin="0,0,0,8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Classes="accentbutton" IsVisible="{Binding !HasCache}" FontSize="15" FontWeight="Bold" Padding="16,5" Command="{Binding FetchCommand}"
                            Content="{Binding [BoothFiles.Fetch], Source={x:Static loc:Localizer.Instance}}"/>
                    <Button Classes="accentbutton" IsVisible="{Binding HasCache}" FontSize="15" FontWeight="Bold" Padding="16,5" Command="{Binding FetchCommand}"
                            Content="{Binding [BoothFiles.Refresh], Source={x:Static loc:Localizer.Instance}}"/>
                    <Button Grid.Column="1" Classes="button" HorizontalAlignment="Right" FontSize="15" Padding="13,5" Command="{Binding OpenBoothLinkCommand}"
                            Content="{Binding [BoothFiles.OpenLink], Source={x:Static loc:Localizer.Instance}}"/>
                </Grid>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsFetching}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" IsVisible="{Binding ShowVariationPicker}">
                <TextBlock Text="{Binding [BoothFiles.Variation], Source={x:Static loc:Localizer.Instance}}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                <ComboBox
                    FontSize="14"
                    ItemsSource="{Binding Variations}"
                    SelectedItem="{Binding SelectedVariation, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{Binding [BoothFiles.Variation], Source={x:Static loc:Localizer.Instance}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:BoothFilesVariation">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" ToolTip.FontFamily="{Binding FontFamily, Source={x:Static vmmain:MainWindowViewModel.Instance}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8">
                    <Panel IsVisible="{Binding HasCache}">
                        <ItemsControl ItemsSource="{Binding SelectedFiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BoothFilesEntry">
                                    <Border
                                        Classes.notadded="{Binding IsNotAdded}"
                                        Classes.added="{Binding !IsNotAdded}"
                                        BorderBrush="{DynamicResource Panel.BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,6">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <materialIcons:MaterialIcon Kind="FileOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding Name}"
                                                TextWrapping="Wrap"
                                                FontSize="14"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="{Binding Name}"
                                                ToolTip.FontFamily="{Binding FontFamily, Source={x:Static vmmain:MainWindowViewModel.Instance}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock IsVisible="{Binding !HasSelectedFiles}"
                                   Text="{Binding [BoothFiles.Empty], Source={x:Static loc:Localizer.Instance}}" TextWrapping="Wrap"/>
                    </Panel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
