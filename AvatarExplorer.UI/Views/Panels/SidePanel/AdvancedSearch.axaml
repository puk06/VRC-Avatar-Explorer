<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AvatarExplorer.UI.ViewModels.Panels"
    xmlns:vmcomponent="using:AvatarExplorer.UI.ViewModels.Component"
    xmlns:loc="using:AvatarExplorer.UI.Localization"
    xmlns:sys="using:System"
    xmlns:converters="using:AvatarExplorer.UI.Converters"
    x:Class="AvatarExplorer.UI.Views.Panels.AdvancedSearch"
    x:DataType="vm:AdvancedSearchViewModel">

    <UserControl.Resources>
        <converters:StartsWithConverter x:Key="StartsWithConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.negationtag">
            <Setter Property="Background" Value="{DynamicResource NegationTag.Background}"/>
        </Style>
        <Style Selector="TextBlock.negationtag">
            <Setter Property="Foreground" Value="{DynamicResource NegationTag.Text}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" VerticalAlignment="Stretch">
        <StackPanel Spacing="3">
            <TextBlock Text="{Binding [SidePanel.AdvancedSearch], Source={x:Static loc:Localizer.Instance}}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
            <TextBlock Text="{Binding [AdvancedSearch.NegationHint], Source={x:Static loc:Localizer.Instance}}" FontSize="12" Opacity="0.75" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}"/>
        </StackPanel>
        <Separator Classes="separator" Grid.Row="1"/>

        <ScrollViewer Grid.Row="2" VerticalAlignment="Stretch">
            <StackPanel Spacing="14" Margin="0,10,10,0">
                <ToggleSwitch IsChecked="{Binding IsOr}" Content="{Binding [AdvancedSearch.OrSearch], Source={x:Static loc:Localizer.Instance}}" FontSize="13"/>
                <ToggleSwitch IsChecked="{Binding IncludeHidden}" Content="{Binding [AdvancedSearch.IncludeHidden], Source={x:Static loc:Localizer.Instance}}" FontSize="13"/>
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding [AdvancedSearch.Title], Source={x:Static loc:Localizer.Instance}}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                    <Separator Classes="separator"/>
                    <TextBox Text="{Binding Title}" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.Title], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding [AdvancedSearch.Author], Source={x:Static loc:Localizer.Instance}}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                    <Separator Classes="separator"/>
                    <TextBox Text="{Binding Author}" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.Author], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding [AdvancedSearch.BoothId], Source={x:Static loc:Localizer.Instance}}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                    <Separator Classes="separator"/>
                    <TextBox Text="{Binding BoothId}" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.BoothId], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding [AdvancedSearch.SupportedAvatar], Source={x:Static loc:Localizer.Instance}}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                    <Separator Classes="separator"/>
                    <TextBox Text="{Binding SupportedAvatar}" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.SupportedAvatar], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding [AdvancedSearch.Category], Source={x:Static loc:Localizer.Instance}}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                    <Separator Classes="separator"/>
                    <ItemsControl ItemsSource="{Binding SelectedCategories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="5" LineSpacing="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmcomponent:AdvancedSearchTagViewModel">
                                <Border Classes="tag" Classes.negationtag="{Binding IsNegation}" CornerRadius="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding [AdvancedSearch.ToggleNegation], Source={x:Static loc:Localizer.Instance}}" Click="OnCategoryToggleNegationClick"/>
                                            <Separator/>
                                            <MenuItem Header="{Binding [AdvancedSearch.Remove], Source={x:Static loc:Localizer.Instance}}" Click="OnCategoryRemoveClick"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <TextBlock Classes="tag" Classes.negationtag="{Binding IsNegation}" Text="{Binding Label}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Padding="8,5"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding [AdvancedSearch.AddCategory], Source={x:Static loc:Localizer.Instance}}" FontSize="12" Opacity="0.75" Foreground="{DynamicResource Text.Secondary}"/>
                    <TextBox Text="{Binding NewCategory}" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.AddCategory], Source={x:Static loc:Localizer.Instance}}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding AddCategoryCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>
                    <TextBlock Text="{Binding [AdvancedSearch.SearchCategory], Source={x:Static loc:Localizer.Instance}}" FontSize="12" Opacity="0.75" Foreground="{DynamicResource Text.Secondary}"/>
                    <TextBox Text="{Binding CategorySearchText}" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.SearchCategory], Source={x:Static loc:Localizer.Instance}}"/>
                    <ComboBox ItemsSource="{Binding FilteredCategories}" FontSize="14" DisplayMemberBinding="{Binding DisplayName}" PlaceholderText="{Binding [AdvancedSearch.SelectCategory], Source={x:Static loc:Localizer.Instance}}" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedCategoryIndex}" SelectionChanged="OnCategorySelectionChanged"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding [AdvancedSearch.Memo], Source={x:Static loc:Localizer.Instance}}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                    <Separator Classes="separator"/>
                    <TextBox Text="{Binding Memo}" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.Memo], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding [AdvancedSearch.ImplementedAvatar], Source={x:Static loc:Localizer.Instance}}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                    <Separator Classes="separator"/>
                    <TextBox Text="{Binding ImplementedAvatar}" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.ImplementedAvatar], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding [AdvancedSearch.NotImplementedAvatar], Source={x:Static loc:Localizer.Instance}}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                    <Separator Classes="separator"/>
                    <TextBox Text="{Binding NotImplementedAvatar}" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.NotImplementedAvatar], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding [AdvancedSearch.Tag], Source={x:Static loc:Localizer.Instance}}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                    <Separator Classes="separator"/>
                    <ItemsControl ItemsSource="{Binding SelectedTags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="5" LineSpacing="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmcomponent:AdvancedSearchTagViewModel">
                                <Border Classes="tag" Classes.negationtag="{Binding IsNegation}" CornerRadius="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding [AdvancedSearch.ToggleNegation], Source={x:Static loc:Localizer.Instance}}" Click="OnTagToggleNegationClick"/>
                                            <Separator/>
                                            <MenuItem Header="{Binding [AdvancedSearch.Remove], Source={x:Static loc:Localizer.Instance}}" Click="OnTagRemoveClick"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <TextBlock Classes="tag" Classes.negationtag="{Binding IsNegation}" Text="{Binding Label}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Padding="8,5"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding [AdvancedSearch.AddTag], Source={x:Static loc:Localizer.Instance}}" FontSize="12" Opacity="0.75" Foreground="{DynamicResource Text.Secondary}"/>
                    <TextBox Text="{Binding NewTag}" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.AddTag], Source={x:Static loc:Localizer.Instance}}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding AddTagCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>
                    <TextBlock Text="{Binding [AdvancedSearch.SearchTag], Source={x:Static loc:Localizer.Instance}}" FontSize="12" Opacity="0.75" Foreground="{DynamicResource Text.Secondary}"/>
                    <TextBox Text="{Binding TagSearchText}" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.SearchTag], Source={x:Static loc:Localizer.Instance}}"/>
                    <ComboBox ItemsSource="{Binding ExistingTags}" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.SelectTag], Source={x:Static loc:Localizer.Instance}}" SelectedIndex="{Binding SelectedTagIndex}" HorizontalAlignment="Stretch" SelectionChanged="OnTagSelectionChanged"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding [AdvancedSearch.CommonAvatar], Source={x:Static loc:Localizer.Instance}}" FontSize="14" Opacity="0.85" Foreground="{DynamicResource Text.Primary}"/>
                    <Separator Classes="separator"/>
                    <TextBox Text="{Binding CommonAvatar}" FontSize="14" PlaceholderText="{Binding [AdvancedSearch.CommonAvatar], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
