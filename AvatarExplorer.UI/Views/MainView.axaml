<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AvatarExplorer.UI.ViewModels"
    xmlns:loc="using:AvatarExplorer.UI.Localization"
    xmlns:panels="using:AvatarExplorer.UI.Views.Panels"
    xmlns:component="using:AvatarExplorer.UI.ViewModels.Component"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:Class="AvatarExplorer.UI.Views.MainView"
    x:DataType="vm:MainViewModel">

    <UserControl.DataContext>
        <vm:MainViewModel/>
    </UserControl.DataContext>

    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Grid.Column="1" Classes="panelbackground">
                <Grid ColumnDefinitions="Auto,Auto,2.3*,Auto,*,Auto" ColumnSpacing="10">
                    <Button Classes="button" Grid.Column="0" Content="{materialIcons:MaterialIconExt Kind=ArrowLeft}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="35" FontSize="19" CornerRadius="8" Padding="15,0,15,0" Command="{Binding UndoCommand}"/>
                    <Button Classes="button" Grid.Column="1" Content="{materialIcons:MaterialIconExt Kind=HomeOutline}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="35" FontSize="19" CornerRadius="8" Padding="15,0,15,0" Command="{Binding HomeCommand}"/>
                    
                    <TextBox Text="{Binding Path}" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" PlaceholderText="{Binding [Main.Path.Placeholder], Source={x:Static loc:Localizer.Instance}}" IsReadOnly="True" FontSize="14" CornerRadius="8"/>
                    
                    <materialIcons:MaterialIcon Grid.Column="3" Kind="Magnify" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox Text="{Binding SearchText}" Grid.Column="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" PlaceholderText="{Binding [Main.Search.Placeholder], Source={x:Static loc:Localizer.Instance}}" FontSize="14" CornerRadius="8"/>
                    
                    <Button Classes="accentbutton" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="8" Margin="5,0,0,0" Command="{Binding AddItemCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <materialIcons:MaterialIcon Kind="Plus" Width="25" Height="25" VerticalAlignment="Center"/>
                            <TextBlock Classes="accentbutton" FontSize="15" FontWeight="Bold" Text="{Binding [Main.AddItem], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Classes="panelbackground">
                <Button Classes="button" FontWeight="Bold" Content="{materialIcons:MaterialIconExt Kind=CogOutline}" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="35" Width="35" FontSize="19" CornerRadius="8" Command="{Binding OpenSettingsCommand}"/>
            </Border>
        </Grid>

        <Panel Margin="0,12,-12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="250" Width="300" MaxWidth="550"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition MinWidth="250" Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition MinWidth="{Binding SidePanelMinWidth}" Width="50" MaxWidth="550"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="Main_LeftPanelBorder" Grid.Column="0" Classes="panelbackground">
                    <Grid RowDefinitions="Auto,*">
                        <TabControl Grid.Row="0" HorizontalAlignment="Stretch" SelectedIndex="0" Margin="-5,-10,5,5" FontSize="18">
                            <TabItem Header="{Binding [Main.Filter.Avatar], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                            <TabItem Header="{Binding [Main.Filter.Author], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                            <TabItem Header="{Binding [Main.Filter.Category], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                        </TabControl>

                        <Grid RowDefinitions="*,Auto" Grid.Row="1" RowSpacing="5">
                            <Panel Grid.Row="0">
                                <Border CornerRadius="8" ClipToBounds="True">
                                    <ScrollViewer x:Name="Main_LeftPanelScrollViewer">
                                        <ItemsControl ItemsSource="{Binding LeftItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="5" Margin="0,0,10,0"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="component:ItemViewModel">
                                                    <Button HorizontalAlignment="Stretch" VerticalAlignment="Top" CornerRadius="8" Padding="7" Command="{Binding $parent[UserControl].DataContext.SelectLeftItemCommand}" CommandParameter="{Binding}">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <Border CornerRadius="8" ClipToBounds="true" HorizontalAlignment="Center" VerticalAlignment="Top">
                                                                <Image Source="{Binding Thumbnail}" Width="{Binding Width}" Height="{Binding Height}" Stretch="Fill" VerticalAlignment="Top"/>
                                                            </Border>

                                                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,5,*">
                                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                                <ItemsControl ItemsSource="{Binding Tags}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Grid.Row="3" Orientation="Horizontal" ItemSpacing="5" LineSpacing="5"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>

                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="component:TagViewModel">
                                                                            <Border CornerRadius="15" HorizontalAlignment="Center" VerticalAlignment="Center" Classes.commonavatar="{Binding IsCommonAvatar}" Classes.tag="{Binding !IsCommonAvatar}">
                                                                                <TextBlock Text="{Binding Label}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,5" Classes.commonavatar="{Binding IsCommonAvatar}" Classes.tag="{Binding !IsCommonAvatar}"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Panel>

                            <Panel x:Name="Main_LeftPanelPageInfo" Grid.Row="1"/>
                        </Grid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Opacity="0"/>

                <Border x:Name="Main_RightPanelBorder" Grid.Column="2" Classes="panelbackground">
                    <Panel>
                        <StackPanel x:Name="Main_RightPanelParent" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsVisible="False">
                            <Image Source="avares://AvatarExplorer/Assets/Internal/EmptyIcon.png" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding [Error.Nothing], Source={x:Static loc:Localizer.Instance}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="25" Foreground="{DynamicResource Text.Primary}"/>
                        </StackPanel>

                        <Grid RowDefinitions="*,Auto" RowSpacing="5">
                            <Panel>
                                <Border CornerRadius="8" ClipToBounds="True">
                                    <ScrollViewer x:Name="Main_RightPanelScrollViewer">
                                        <ItemsControl ItemsSource="{Binding MainItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="5" Margin="0,0,10,0"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="component:ItemViewModel">
                                                    <Button HorizontalAlignment="Stretch" VerticalAlignment="Top" CornerRadius="8" Padding="7"  Command="{Binding $parent[UserControl].DataContext.SelectRightItemCommand}" CommandParameter="{Binding}">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <Border CornerRadius="8" ClipToBounds="true" HorizontalAlignment="Center" VerticalAlignment="Top">
                                                                <Image Source="{Binding Thumbnail}" Width="{Binding Width}" Height="{Binding Height}" Stretch="Fill" VerticalAlignment="Top"/>
                                                            </Border>

                                                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,5,*">
                                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                                <ItemsControl ItemsSource="{Binding Tags}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Grid.Row="3" Orientation="Horizontal" ItemSpacing="5" LineSpacing="5"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>

                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="component:TagViewModel">
                                                                            <Border CornerRadius="15" HorizontalAlignment="Center" VerticalAlignment="Center" Classes.commonavatar="{Binding IsCommonAvatar}" Classes.tag="{Binding !IsCommonAvatar}">
                                                                                <TextBlock Text="{Binding Label}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,5" Classes.commonavatar="{Binding IsCommonAvatar}" Classes.tag="{Binding !IsCommonAvatar}"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Panel>

                            <Panel x:Name="Main_RightPanelPageInfo" Grid.Row="1"/>
                        </Grid>
                    </Panel>
                </Border>

                <GridSplitter Grid.Column="3" Opacity="0" IsVisible="{Binding IsSidePanelVisible}"/>

                <Panel x:Name="Main_SidePanel" Grid.Column="4" HorizontalAlignment="Stretch">
                    <Border Classes="panelbackground" IsVisible="{Binding !IsSidePanelVisible}" CornerRadius="12,0,0,12" Width="50">
                        <StackPanel Spacing="10">
                            <Button Classes="button sidepanelbutton" Content="{materialIcons:MaterialIconExt Kind=TextSearch}" ToolTip.Tip="{Binding [SidePanel.AdvancedSearch], Source={x:Static loc:Localizer.Instance}}" FontSize="17" Tag="0" Command="{Binding OpenSidePanelCommand}" CommandParameter="{Binding}"/>
                            <Button Classes="button sidepanelbutton" Content="{materialIcons:MaterialIconExt Kind=DownloadMultiple}" ToolTip.Tip="{Binding [SidePanel.BulkImport], Source={x:Static loc:Localizer.Instance}}" FontSize="17" Tag="1" Command="{Binding OpenSidePanelCommand}" CommandParameter="{Binding}"/>
                            <Button Classes="button sidepanelbutton" Content="{materialIcons:MaterialIconExt Kind=FolderStarMultipleOutline}" ToolTip.Tip="{Binding [SidePanel.BulkImportPreset], Source={x:Static loc:Localizer.Instance}}" FontSize="17" Tag="2" Command="{Binding OpenSidePanelCommand}" CommandParameter="{Binding}"/>
                            <Button Classes="button sidepanelbutton" Content="{materialIcons:MaterialIconExt Kind=InformationOutline}" ToolTip.Tip="{Binding [SidePanel.ItemDetails], Source={x:Static loc:Localizer.Instance}}" FontSize="17" Tag="3" Command="{Binding OpenSidePanelCommand}" CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="Main_SidePanelBorder" Classes="panelbackground" IsVisible="False" CornerRadius="12,0,0,12">
                        <Grid RowSpacing="10">
                            <Grid Grid.Row="2" ColumnSpacing="10">
                                <TabControl x:Name="SidePanel_TabControl" HorizontalAlignment="Stretch" SelectedIndex="0" FontSize="18" Margin="0,0,-10,0" TabStripPlacement="Right">
                                    <TabItem x:Name="SidePanel_AdvancedSearchTab" ToolTip.Tip="{Binding [SidePanel.AdvancedSearch], Source={x:Static loc:Localizer.Instance}}">
                                        <TabItem.Header>
                                            <materialIcons:MaterialIcon Kind="TextSearch" Width="16" Height="16"/>
                                        </TabItem.Header>
                                        <panels:AdvancedSearch/>
                                    </TabItem>

                                    <TabItem x:Name="SidePanel_BulkImportPanelTab" ToolTip.Tip="{Binding [SidePanel.BulkImport], Source={x:Static loc:Localizer.Instance}}">
                                        <TabItem.Header>
                                            <materialIcons:MaterialIcon Kind="DownloadMultiple" Width="16" Height="16"/>
                                        </TabItem.Header>
                                    </TabItem>

                                    <TabItem x:Name="SidePanel_BulkImportPresetPanelTab" ToolTip.Tip="{Binding [SidePanel.BulkImportPreset], Source={x:Static loc:Localizer.Instance}}">
                                        <TabItem.Header>
                                            <materialIcons:MaterialIcon Kind="FolderStarMultipleOutline" Width="16" Height="16"/>
                                        </TabItem.Header>
                                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" VerticalAlignment="Stretch">
                                            <TextBlock Text="{Binding [SidePanel.BulkImportPreset], Source={x:Static loc:Localizer.Instance}}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>

                                            <Separator Classes="separator" Grid.Row="1"/>

                                            <Grid Grid.Row="2" RowDefinitions="*,Auto,Auto" RowSpacing="10" Margin="-10,0,-10,0" VerticalAlignment="Stretch">
                                                <ScrollViewer x:Name="SidePanel_BulkImportPresetPanelScrollViewer" Grid.Row="0" DragDrop.AllowDrop="True">
                                                    <StackPanel x:Name="SidePanel_BulkImportPresetPanel" Spacing="5" Margin="0,0,10,0"/>
                                                </ScrollViewer>
                                            </Grid>
                                        </Grid>
                                    </TabItem>

                                    <TabItem x:Name="SidePanel_ItemDetailsTab" ToolTip.Tip="{Binding [SidePanel.ItemDetails], Source={x:Static loc:Localizer.Instance}}">
                                        <TabItem.Header>
                                            <materialIcons:MaterialIcon Kind="InformationOutline" Width="16" Height="16"/>
                                        </TabItem.Header>
                                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" VerticalAlignment="Stretch">
                                            <TextBlock Text="{Binding [SidePanel.ItemDetails], Source={x:Static loc:Localizer.Instance}}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                                            
                                            <Separator Classes="separator" Grid.Row="1"/>

                                            <ScrollViewer Grid.Row="2" VerticalAlignment="Stretch">
                                                <Grid x:Name="SidePanel_ItemDetailsContent" RowSpacing="12"/>
                                            </ScrollViewer>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Grid>
                    </Border>
                </Panel>
            </Grid>
        </Panel>
    </DockPanel>
</UserControl>
