<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AvatarExplorer.UI.ViewModels.Overlays"
    xmlns:loc="using:AvatarExplorer.UI.Localization"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:Class="AvatarExplorer.UI.Views.Overlays.TagEditorDialog"
    x:DataType="vm:TagEditorViewModel">

    <Border Classes="overlaybackground">
        <Border Classes="overlay" Width="500">
            <StackPanel Spacing="15">

                <!-- タイトル -->
                <TextBlock Text="{Binding [TagEditor.Title], Source={x:Static loc:Localizer.Instance}}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Left" Foreground="{DynamicResource Text.Primary}"/>

                <StackPanel Margin="0,10,0,10" Spacing="10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding [TagEditor.OldTag], Source={x:Static loc:Localizer.Instance}}" FontSize="13" Opacity="0.7" Foreground="{DynamicResource Text.Secondary}"/>
                        <ComboBox ItemsSource="{Binding ExistTags}" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedTagIndex}"/>
                    </StackPanel>

                    <materialIcons:MaterialIcon Kind="ArrowDown" Width="25" Height="25" VerticalAlignment="Center" Margin="0,5,0,0"/>

                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding [TagEditor.NewTagName], Source={x:Static loc:Localizer.Instance}}" FontSize="13" Opacity="0.7" Foreground="{DynamicResource Text.Secondary}"/>
                        <TextBox Text="{Binding NewTagName}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="10">
                    <Button Classes="accentbutton" FontWeight="Bold" Content="{Binding [TagEditor.Rename], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Command="{Binding RenameCommand}"/>
                    <Button Classes="accentbutton" FontWeight="Bold" Content="{Binding [TagEditor.Remove], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Command="{Binding RemoveCommand}"/>
                    <Button Classes="button" FontWeight="Bold" Content="{Binding [Button.Close], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Command="{Binding CloseCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
