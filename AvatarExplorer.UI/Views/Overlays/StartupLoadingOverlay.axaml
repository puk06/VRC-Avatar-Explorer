<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AvatarExplorer.UI.ViewModels.Overlays"
    x:Class="AvatarExplorer.UI.Views.Overlays.StartupLoadingOverlay"
    x:DataType="vm:StartupLoadingViewModel">

    <Grid Background="#FDF2F8" IsVisible="{Binding IsVisible}">
        <Grid>
            <Ellipse Width="360" Height="360" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-110,-110,0,0" Fill="#FFD1DC" Opacity="0.45"/>
            <Ellipse Width="240" Height="240" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-80" Fill="#B5D8F7" Opacity="0.45"/>
        </Grid>

        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" Padding="32" CornerRadius="28" Background="#FFFDF9" BorderBrush="#F8C8DC" BorderThickness="1">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <Border Width="88" Height="88" CornerRadius="44" Background="#FFFFFF" BorderBrush="#F8C8DC" BorderThickness="2" HorizontalAlignment="Center" ClipToBounds="True">
                    <Image Source="avares://AvatarExplorer/Assets/Internal/SoftwareIcon.png" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="VRC Avatar Explorer" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#4B3F35"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Foreground="#7B6B5E"/>
                </StackPanel>

                <ProgressBar Width="320" Height="8" Minimum="0" Maximum="100" Value="{Binding Progress}" IsIndeterminate="False" Background="#E8DDD2">
                    <ProgressBar.Foreground>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#FFB6C1" Offset="0"/>
                            <GradientStop Color="#ADD8E6" Offset="1"/>
                        </LinearGradientBrush>
                    </ProgressBar.Foreground>
                </ProgressBar>

                <TextBlock Text="Please wait a moment." FontSize="12" HorizontalAlignment="Center" Foreground="#8B7A6A"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
