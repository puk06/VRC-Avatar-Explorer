<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AvatarExplorer.UI.ViewModels.Overlays"
    x:Class="AvatarExplorer.UI.Views.Overlays.FatalErrorOverlay"
    x:DataType="vm:FatalErrorViewModel">

    <!-- 致命的なエラーオーバーレイ -->
    <Border Classes="overlaybackground">
        <Border Classes="overlay" Width="520" Padding="24">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource Text.Primary}"/>
                <TextBlock Text="{Binding Content}" FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"/>
                <TextBlock FontSize="12" Opacity="0.8" Text="The application will close automatically." Foreground="{DynamicResource Text.Secondary}"/>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
