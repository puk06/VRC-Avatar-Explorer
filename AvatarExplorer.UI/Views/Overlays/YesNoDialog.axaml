<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AvatarExplorer.UI.ViewModels.Overlays"
    xmlns:loc="using:AvatarExplorer.UI.Localization"
    x:Class="AvatarExplorer.UI.Views.Overlays.YesNoDialogOverlay"
    x:DataType="vm:YesNoDialogViewModel">

    <UserControl.DataContext>
        <vm:YesNoDialogViewModel/>
    </UserControl.DataContext>

    <Border Classes="overlaybackground">
        <Border Classes="overlay" Width="500">
            <StackPanel Spacing="15">

                <!-- タイトル -->
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Left" Foreground="{DynamicResource Text.Primary}"/>

                <!-- 内容 -->
                <TextBlock Text="{Binding Content}" FontSize="17" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,10,0,10" Foreground="{DynamicResource Text.Primary}"/>
                
                <!-- Yes/Noボタン -->
                <Grid ColumnDefinitions="100,*,100">
                    <Button Classes="button" FontWeight="Bold" Grid.Column="0" Content="{Binding [DialogResult.No], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Command="{Binding NoCommand}"/>
                    <Button Classes="accentbutton" FontWeight="Bold" Grid.Column="2" Content="{Binding [DialogResult.Yes], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Command="{Binding YesCommand}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
