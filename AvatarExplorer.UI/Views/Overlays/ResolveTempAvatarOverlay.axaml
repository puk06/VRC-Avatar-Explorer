<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AvatarExplorer.UI.ViewModels.Overlays"
    xmlns:loc="using:AvatarExplorer.UI.Localization"
    xmlns:vmcomponent="using:AvatarExplorer.UI.ViewModels.Component"
    x:Class="AvatarExplorer.UI.Views.Overlays.ResolveTempAvatarOverlay"
    x:DataType="vm:ResolveTempAvatarViewModel">

    <Border Classes="overlaybackground">
        <Border Classes="overlay" Width="800">
            <StackPanel Spacing="10">
                <Grid RowDefinitions="Auto,20,Auto,10,Auto,20,Auto">

                    <!-- タイトル -->
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="{Binding [ResolveTempAvatar.Title], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                    
                    <!-- 検索バー -->
                    <TextBox Grid.Row="2" Text="{Binding SearchText}" PlaceholderText="{Binding [ResolveTempAvatar.Search], Source={x:Static loc:Localizer.Instance}}"/>

                    <!-- アバターリスト -->
                    <ScrollViewer Grid.Row="4" Height="500">
                        <ItemsControl ItemsSource="{Binding Avatars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Margin="0,0,10,0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vmcomponent:ItemViewModel">
                                    <Button Classes="button" HorizontalAlignment="Stretch" VerticalAlignment="Top" CornerRadius="8" Padding="7" Margin="0,0,0,5" Command="{Binding $parent[UserControl].DataContext.SelectItemCommand}" CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border CornerRadius="8" ClipToBounds="true" HorizontalAlignment="Center" VerticalAlignment="Top">
                                                <Image Source="{Binding Thumbnail}" Width="{Binding Width}" Height="{Binding Height}" Stretch="Fill" VerticalAlignment="Top"  Loaded="OnItemImageLoaded"/>
                                            </Border>

                                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,5,*">
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid ColumnDefinitions="*,180" Grid.Row="6" Margin="10,0,10,0" ColumnSpacing="20">
                        <Button Classes="button" FontWeight="Bold" Grid.Column="1" Content="{Binding [Button.Cancel], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Command="{Binding CancelCommand}"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
