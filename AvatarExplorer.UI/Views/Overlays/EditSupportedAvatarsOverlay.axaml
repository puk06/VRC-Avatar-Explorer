<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AvatarExplorer.UI.ViewModels.Overlays"
    xmlns:loc="using:AvatarExplorer.UI.Localization"
    xmlns:vmcomponent="using:AvatarExplorer.UI.ViewModels.Component"
    x:Class="AvatarExplorer.UI.Views.Overlays.EditSupportedAvatarsOverlay"
    x:DataType="vm:EditSupportedAvatarsViewModel">

    <UserControl.DataContext>
        <vm:EditSupportedAvatarsViewModel/>
    </UserControl.DataContext>
    
    <Border Classes="overlaybackground">
        <Border Classes="overlay" Width="800">
            <StackPanel Spacing="10">
                <Grid RowDefinitions="Auto,20,Auto,10,Auto,20,Auto">

                    <!-- タイトル -->
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="{Binding [EditSupportedAvatars.Title], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                    
                    <!-- 検索バー -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="{Binding [EditSupportedAvatars.Search], Source={x:Static loc:Localizer.Instance}}"/>
                        <Button Grid.Column="1" Classes="button" Content="{Binding [Button.SelectVisible], Source={x:Static loc:Localizer.Instance}}" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="12,6" Command="{Binding SelectVisibleCommand}"/>
                    </Grid>

                    <!-- アバターリスト -->
                    <ScrollViewer Grid.Row="4" Height="500">
                        <ItemsControl ItemsSource="{Binding Avatars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="5" Margin="0,0,10,0"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vmcomponent:ItemViewModel">
                                    <Button HorizontalAlignment="Stretch" VerticalAlignment="Top" CornerRadius="8" Padding="7" Command="{Binding $parent[UserControl].DataContext.SelectItemCommand}" CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border CornerRadius="8" ClipToBounds="true" HorizontalAlignment="Center" VerticalAlignment="Top">
                                                <Image Source="{Binding Thumbnail}" Width="{Binding Width}" Height="{Binding Height}" Stretch="Fill" VerticalAlignment="Top"/>
                                            </Border>

                                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,5,*">
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 下のボタン -->
                    <Grid ColumnDefinitions="200,*,150,150" Grid.Row="6" Margin="10,0,10,0" ColumnSpacing="20">
                        <Button Classes="button" FontWeight="Bold" Grid.Column="0" Content="{Binding [EditSupportedAvatars.AddTempAvatar], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Command="{Binding AddTempAvatarCommand}"/>
                        <Button Classes="button" FontWeight="Bold" Grid.Column="2" Content="{Binding [Button.Cancel], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Command="{Binding CancelCommand}"/>
                        <Button Classes="accentbutton" FontWeight="Bold" Grid.Column="3" Content="{Binding [Button.Confirm], Source={x:Static loc:Localizer.Instance}}" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Command="{Binding ConfirmCommand}"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
