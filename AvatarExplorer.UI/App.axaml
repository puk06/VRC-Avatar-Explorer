<Application xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AvatarExplorer.UI"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="AvatarExplorer.UI.App"
        RequestedThemeVariant="Dark">
        <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- 画面全体や通常パネルの背景 -->
                    <SolidColorBrush x:Key="Background.Window" Color="#81EAEAEA"/>
                    <!-- モーダルやオーバーレイの背景 -->
                    <SolidColorBrush x:Key="Background.Overlay" Color="#FFD7D7D7"/>
                    <!-- カードや内側領域の面色 -->
                    <SolidColorBrush x:Key="Background.Surface" Color="#FFDCDCDC"/>

                    <!-- 区切り線の色 -->
                    <SolidColorBrush x:Key="Separator.Background" Color="#22000000"/>

                    <!-- 主文言の色 -->
                    <SolidColorBrush x:Key="Text.Primary" Color="#FF1A1A1A"/>
                    <!-- 補助文言の色 -->
                    <SolidColorBrush x:Key="Text.Secondary" Color="#FF555555"/>
                    <!-- アクセントボタン上の文字色 -->
                    <SolidColorBrush x:Key="Text.Accent" Color="#FFFFFFFF"/>

                    <!-- 通常ボタンの背景 -->
                    <SolidColorBrush x:Key="Button.Background" Color="#5ADEE2E2"/>
                    <!-- 通常ボタンのホバー背景 -->
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="#74D1D7D7"/>
                    <!-- ボタン枠線の色 -->
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="#6A808080"/>
                    <!-- 選択中の強調色 -->
                    <SolidColorBrush x:Key="Button.Selected" Color="#8600A900"/>
                    <!-- アクセントボタンの背景 -->
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="#FF2F7ECB"/>
                    <!-- アクセントボタンのホバー背景 -->
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="#FF3F8FDE"/>

                    <!-- パネル枠線の色 -->
                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="#6A808080"/>

                    <!-- 共通素体アバターの背景 -->
                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="#FF008000"/>
                    <!-- 共通素体アバターの文字色 -->
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="#FFFFFFFF"/>

                    <!-- タグの背景 -->
                    <SolidColorBrush x:Key="Tag.Background" Color="#FF2B78BF"/>
                    <!-- タグの文字色 -->
                    <SolidColorBrush x:Key="Tag.Text" Color="#FFFFFFFF"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Background.Window" Color="#6C414141"/>
                    <SolidColorBrush x:Key="Background.Overlay" Color="#FF333333"/>
                    <SolidColorBrush x:Key="Background.Surface" Color="#FF1E1E1E"/>

                    <SolidColorBrush x:Key="Separator.Background" Color="#22FFFFFF"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="#FFF2F2F2"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="#FFB0B0B0"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="#FFFFFFFF"/>

                    <SolidColorBrush x:Key="Button.Background" Color="#33FFFFFF"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="#4DFFFFFF"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="#00000000"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="#8600A900"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="#FF4A90E2"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="#FF5EA0EA"/>

                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="#00000000"/>

                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="#FF008000"/>
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="#FFFFFFFF"/>

                    <SolidColorBrush x:Key="Tag.Background" Color="#FF2B78BF"/>
                    <SolidColorBrush x:Key="Tag.Text" Color="#FFFFFFFF"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static ui:AppThemeVariants.Sakura}">
                    <SolidColorBrush x:Key="Background.Window" Color="#82F2E4E8"/>
                    <SolidColorBrush x:Key="Background.Overlay" Color="#FFE8DEE1"/>
                    <SolidColorBrush x:Key="Background.Surface" Color="#FFD7C4CB"/>

                    <SolidColorBrush x:Key="Separator.Background" Color="#22B27F91"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="#FF4B313B"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="#FF6D4E59"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="#FFFFF8FB"/>

                    <SolidColorBrush x:Key="Button.Background" Color="#64D6BEC7"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="#80E0CCD4"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="#6BB27F91"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="#70C883A2"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="#FFC96BDD"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="#FFD57BE6"/>

                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="#6BB27F91"/>

                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="#FFC24F7B"/>
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="#FFFFFFFF"/>

                    <SolidColorBrush x:Key="Tag.Background" Color="#FFD17FA8"/>
                    <SolidColorBrush x:Key="Tag.Text" Color="#FFFFF7FA"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static ui:AppThemeVariants.Mint}">
                    <SolidColorBrush x:Key="Background.Window" Color="#82DDEDE4"/>
                    <SolidColorBrush x:Key="Background.Overlay" Color="#FFDCE7E1"/>
                    <SolidColorBrush x:Key="Background.Surface" Color="#FFC6D8D0"/>

                    <SolidColorBrush x:Key="Separator.Background" Color="#226B9C8E"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="#FF253B35"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="#FF456459"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="#FFF6FFFB"/>

                    <SolidColorBrush x:Key="Button.Background" Color="#64B2CCBF"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="#80C4D9CE"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="#6B6B9C8E"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="#7089C0AD"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="#FF6E75D2"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="#FF838EE0"/>

                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="#6B6B9C8E"/>

                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="#FF28765C"/>
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="#FFFFFFFF"/>

                    <SolidColorBrush x:Key="Tag.Background" Color="#FF63B892"/>
                    <SolidColorBrush x:Key="Tag.Text" Color="#FFF7FFFC"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static ui:AppThemeVariants.Lavender}">
                    <SolidColorBrush x:Key="Background.Window" Color="#82DDD6F0"/>
                    <SolidColorBrush x:Key="Background.Overlay" Color="#FFE0DBEE"/>
                    <SolidColorBrush x:Key="Background.Surface" Color="#FFCFC8E3"/>

                    <SolidColorBrush x:Key="Separator.Background" Color="#228674B0"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="#FF332B49"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="#FF52486F"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="#FFFCFBFF"/>

                    <SolidColorBrush x:Key="Button.Background" Color="#64C5BBDD"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="#80D3CBEB"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="#6B8674B0"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="#70927BD1"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="#FF6D54C2"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="#FF8368D1"/>

                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="#6B8674B0"/>

                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="#FF5B45B2"/>
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="#FFFFFFFF"/>

                    <SolidColorBrush x:Key="Tag.Background" Color="#FF8F76DD"/>
                    <SolidColorBrush x:Key="Tag.Text" Color="#FFFBF9FF"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static ui:AppThemeVariants.Ocean}">
                    <SolidColorBrush x:Key="Background.Window" Color="#8247637B"/>
                    <SolidColorBrush x:Key="Background.Overlay" Color="#FF40586B"/>
                    <SolidColorBrush x:Key="Background.Surface" Color="#FF334759"/>

                    <SolidColorBrush x:Key="Separator.Background" Color="#227FA4BC"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="#FFF4FAFF"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="#FFC7D8E4"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="#FFFFFFFF"/>

                    <SolidColorBrush x:Key="Button.Background" Color="#644E7086"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="#806188A1"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="#6B7FA4BC"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="#7096C7DF"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="#FF2D9AC9"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="#FF47ACD6"/>

                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="#6B7FA4BC"/>

                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="#FF1F7FA6"/>
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="#FFFFFFFF"/>

                    <SolidColorBrush x:Key="Tag.Background" Color="#FF4FA8CC"/>
                    <SolidColorBrush x:Key="Tag.Text" Color="#FFFFFFFF"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static ui:AppThemeVariants.Sunset}">
                    <SolidColorBrush x:Key="Background.Window" Color="#82F6E3D4"/>
                    <SolidColorBrush x:Key="Background.Overlay" Color="#FFF0DDD0"/>
                    <SolidColorBrush x:Key="Background.Surface" Color="#FFE3CCBD"/>

                    <SolidColorBrush x:Key="Separator.Background" Color="#22B98566"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="#FF4B2F22"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="#FF6D4637"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="#FFFFFBF7"/>

                    <SolidColorBrush x:Key="Button.Background" Color="#64D7B8A6"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="#80E2C9BA"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="#6BB98566"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="#70CF8A63"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="#FFE07A57"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="#FFEB8F6D"/>

                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="#6BB98566"/>

                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="#FFC95D3D"/>
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="#FFFFFFFF"/>

                    <SolidColorBrush x:Key="Tag.Background" Color="#FFD9904F"/>
                    <SolidColorBrush x:Key="Tag.Text" Color="#FFFFFBF8"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static ui:AppThemeVariants.Forest}">
                    <SolidColorBrush x:Key="Background.Window" Color="#82D8E4D7"/>
                    <SolidColorBrush x:Key="Background.Overlay" Color="#FFD6E2D5"/>
                    <SolidColorBrush x:Key="Background.Surface" Color="#FFC2D2C0"/>

                    <SolidColorBrush x:Key="Separator.Background" Color="#225F8B69"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="#FF223327"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="#FF3D5843"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="#FFF8FFFA"/>

                    <SolidColorBrush x:Key="Button.Background" Color="#649DBAA0"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="#80B2C8B4"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="#6B5F8B69"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="#7083B07F"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="#FF4E7C52"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="#FF639767"/>

                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="#6B5F8B69"/>

                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="#FF2E6E3D"/>
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="#FFFFFFFF"/>

                    <SolidColorBrush x:Key="Tag.Background" Color="#FF4D9468"/>
                    <SolidColorBrush x:Key="Tag.Text" Color="#FFF8FFF9"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static ui:AppThemeVariants.Mocha}">
                    <SolidColorBrush x:Key="Background.Window" Color="#826E5D56"/>
                    <SolidColorBrush x:Key="Background.Overlay" Color="#FF6E5B55"/>
                    <SolidColorBrush x:Key="Background.Surface" Color="#FF5B4B45"/>

                    <SolidColorBrush x:Key="Separator.Background" Color="#22C19A87"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="#FFF7F0EC"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="#FFDCC9C0"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="#FFFFFFFF"/>

                    <SolidColorBrush x:Key="Button.Background" Color="#64866B63"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="#809C7F75"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="#6BC19A87"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="#70B07A66"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="#FFB98262"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="#FFC89478"/>

                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="#6BC19A87"/>

                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="#FF875746"/>
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="#FFFFFFFF"/>
                    
                    <SolidColorBrush x:Key="Tag.Background" Color="#FFB27D62"/>
                    <SolidColorBrush x:Key="Tag.Text" Color="#FFFFFFFF"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static ui:AppThemeVariants.Slate}">
                    <SolidColorBrush x:Key="Background.Window" Color="#82545A67"/>
                    <SolidColorBrush x:Key="Background.Overlay" Color="#FF575E6E"/>
                    <SolidColorBrush x:Key="Background.Surface" Color="#FF454C5A"/>

                    <SolidColorBrush x:Key="Separator.Background" Color="#229AA5BA"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="#FFF5F7FA"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="#FFCAD2DC"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="#FFFFFFFF"/>

                    <SolidColorBrush x:Key="Button.Background" Color="#646A7384"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="#807E889A"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="#6B9AA5BA"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="#7090A4C5"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="#FF6884A4"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="#FF7A96B6"/>

                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="#6B9AA5BA"/>

                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="#FF556F8A"/>
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="#FFFFFFFF"/>

                    <SolidColorBrush x:Key="Tag.Background" Color="#FF7C92AD"/>
                    <SolidColorBrush x:Key="Tag.Text" Color="#FFFFFFFF"/>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <Style Selector="Border.overlaybackground">
            <Setter Property="Background" Value="#80000000"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        
        <Style Selector="Border.commonavatar">
            <Setter Property="Background" Value="{DynamicResource CommonAvatar.Background}"/>
        </Style>

        <Style Selector="TextBlock.commonavatar">
            <Setter Property="Foreground" Value="{DynamicResource CommonAvatar.Text}"/>
        </Style>

        <Style Selector="Border.tag">
            <Setter Property="Background" Value="{DynamicResource Tag.Background}"/>
        </Style>

        <Style Selector="TextBlock.tag">
            <Setter Property="Foreground" Value="{DynamicResource Tag.Text}"/>
        </Style>

        <Style Selector="Border.panelbackground">
            <Setter Property="Background" Value="{DynamicResource Background.Window}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Panel.BorderBrush}"/>
        </Style>

        <Style Selector="Border.overlay">
            <Setter Property="Background" Value="{DynamicResource Background.Overlay}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style Selector="Button.button">
            <Setter Property="Background" Value="{DynamicResource Button.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.BorderBrush}"/>
        </Style>

        <Style Selector="Button.button:pointerover">
            <Setter Property="Background" Value="{DynamicResource Button.Background.PointerOver}"/>
        </Style>

        <Style Selector="Button.button /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Button.Background}"/>
        </Style>

        <Style Selector="Button.button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Button.Background.PointerOver}"/>
        </Style>

        <Style Selector="Button.accentbutton">
            <Setter Property="Background" Value="{DynamicResource Button.AccentBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.BorderBrush}"/>
        </Style>

        <Style Selector="Button.accentbutton:pointerover">
            <Setter Property="Background" Value="{DynamicResource Button.AccentBackground.PointerOver}"/>
        </Style>

        <Style Selector="Button.accentbutton /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Button.AccentBackground}"/>
        </Style>

        <Style Selector="Button.accentbutton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Button.AccentBackground.PointerOver}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Accent}"/>
        </Style>

        <Style Selector="Button.pagebutton">
            <Setter Property="Width" Value="50"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.sidepanelbutton">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <Style Selector="Separator.separator">
            <Setter Property="Background" Value="{DynamicResource Separator.Background}"/>
        </Style>

        <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="ScrollBar">
            <Setter Property="HideDelay" Value="00:00:00"/>
            <Setter Property="ShowDelay" Value="00:00:00"/>
        </Style>

        <Style Selector="TextBlock.settingslabel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style Selector="TextBlock.settingslabel.title">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        </Style>

        <Style Selector="TextBlock.settingslabel.description">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        </Style>

        <materialIcons:MaterialIconStyles/>
        
        <FluentTheme/>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </Application.Styles>

</Application>
