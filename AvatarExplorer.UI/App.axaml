<Application xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AvatarExplorer.UI"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="AvatarExplorer.UI.App"
        RequestedThemeVariant="Dark">
        <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Background.TransparentMain" Color="#B8E8E8E8"/>
                    <SolidColorBrush x:Key="Background.BorderBrush" Color="#54000000"/>
                    <SolidColorBrush x:Key="Background.Panel" Color="#81EAEAEA"/>
                    <SolidColorBrush x:Key="Background.CommonAvatar" Color="#FF008000"/>
                    <SolidColorBrush x:Key="Background.Tag" Color="#FF2B78BF"/>

                    <SolidColorBrush x:Key="BorderBrush.Main" Color="#FFE0E0E0"/>
                    <SolidColorBrush x:Key="Background.Main" Color="#FFD7D7D7"/>
                    <SolidColorBrush x:Key="Background.Sub" Color="#FFDCDCDC"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="#FF1A1A1A"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="#FF666666"/>
                    <SolidColorBrush x:Key="Text.Disabled" Color="#FF9E9E9E"/>
                    <SolidColorBrush x:Key="Text.CommonAvatar" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="Text.Tag" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="#FFFFFFFF"/>

                    <SolidColorBrush x:Key="Button.Background" Color="#5ADEE2E2"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="#74D1D7D7"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="#6A808080"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="#8600A900"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="#FF2F7ECB"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="#FF3F8FDE"/>
                    
                    <SolidColorBrush x:Key="GridSplitter.Background" Color="#FFC8C8C8"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Background.TransparentMain" Color="#DB333333"/>
                    <SolidColorBrush x:Key="Background.BorderBrush" Color="#00000000"/>
                    <SolidColorBrush x:Key="Background.Panel" Color="#6C414141"/>
                    <SolidColorBrush x:Key="Background.CommonAvatar" Color="#FF008000"/>
                    <SolidColorBrush x:Key="Background.Tag" Color="#FF2B78BF"/>

                    <SolidColorBrush x:Key="BorderBrush.Main" Color="#FF2A2A2A"/>
                    <SolidColorBrush x:Key="Background.Main" Color="#FF333333"/>
                    <SolidColorBrush x:Key="Background.Sub" Color="#FF1E1E1E"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="#FFF2F2F2"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="#FFB0B0B0"/>
                    <SolidColorBrush x:Key="Text.Disabled" Color="#FF777777"/>
                    <SolidColorBrush x:Key="Text.CommonAvatar" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="Text.Tag" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="#FFFFFFFF"/>

                    <SolidColorBrush x:Key="Button.Background" Color="#33FFFFFF"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="#4DFFFFFF"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="#00000000"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="#8600A900"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="#FF4A90E2"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="#FF5EA0EA"/>

                    <SolidColorBrush x:Key="GridSplitter.Background" Color="#FF646464"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static ui:AppThemeVariants.Sakura}">
                    <SolidColorBrush x:Key="Background.TransparentMain" Color="#A8E7DEE2"/>
                    <SolidColorBrush x:Key="Background.BorderBrush" Color="#2AB78FA0"/>
                    <SolidColorBrush x:Key="Background.Panel" Color="#82F2E4E8"/>
                    <SolidColorBrush x:Key="Background.CommonAvatar" Color="#FFC24F7B"/>
                    <SolidColorBrush x:Key="Background.Tag" Color="#FFD17FA8"/>

                    <SolidColorBrush x:Key="BorderBrush.Main" Color="#FFD8C0C8"/>
                    <SolidColorBrush x:Key="Background.Main" Color="#FFE8DEE1"/>
                    <SolidColorBrush x:Key="Background.Sub" Color="#FFD7C4CB"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="#FF4B313B"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="#FF81606C"/>
                    <SolidColorBrush x:Key="Text.Disabled" Color="#FFB4939E"/>
                    <SolidColorBrush x:Key="Text.CommonAvatar" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="Text.Tag" Color="#FFFFF7FA"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="#FFFFF8FB"/>

                    <SolidColorBrush x:Key="Button.Background" Color="#64D6BEC7"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="#80E0CCD4"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="#6BB27F91"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="#70C883A2"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="#FFC96BDD"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="#FFD57BE6"/>

                    <SolidColorBrush x:Key="GridSplitter.Background" Color="#FFCAA9B4"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static ui:AppThemeVariants.Mint}">
                    <SolidColorBrush x:Key="Background.TransparentMain" Color="#A5D7EAE1"/>
                    <SolidColorBrush x:Key="Background.BorderBrush" Color="#2A76B0A0"/>
                    <SolidColorBrush x:Key="Background.Panel" Color="#82DDEDE4"/>
                    <SolidColorBrush x:Key="Background.CommonAvatar" Color="#FF28765C"/>
                    <SolidColorBrush x:Key="Background.Tag" Color="#FF63B892"/>

                    <SolidColorBrush x:Key="BorderBrush.Main" Color="#FFC3D7CD"/>
                    <SolidColorBrush x:Key="Background.Main" Color="#FFDCE7E1"/>
                    <SolidColorBrush x:Key="Background.Sub" Color="#FFC6D8D0"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="#FF253B35"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="#FF56756A"/>
                    <SolidColorBrush x:Key="Text.Disabled" Color="#FF86A49A"/>
                    <SolidColorBrush x:Key="Text.CommonAvatar" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="Text.Tag" Color="#FFF7FFFC"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="#FFF6FFFB"/>

                    <SolidColorBrush x:Key="Button.Background" Color="#64B2CCBF"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="#80C4D9CE"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="#6B6B9C8E"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="#7089C0AD"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="#FF6E75D2"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="#FF838EE0"/>

                    <SolidColorBrush x:Key="GridSplitter.Background" Color="#FFAAC9BE"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static ui:AppThemeVariants.Lavender}">
                    <SolidColorBrush x:Key="Background.TransparentMain" Color="#A7E3DFF0"/>
                    <SolidColorBrush x:Key="Background.BorderBrush" Color="#2A9C8AB8"/>
                    <SolidColorBrush x:Key="Background.Panel" Color="#82DDD6F0"/>
                    <SolidColorBrush x:Key="Background.CommonAvatar" Color="#FF5B45B2"/>
                    <SolidColorBrush x:Key="Background.Tag" Color="#FF8F76DD"/>

                    <SolidColorBrush x:Key="BorderBrush.Main" Color="#FFC8C1E0"/>
                    <SolidColorBrush x:Key="Background.Main" Color="#FFE0DBEE"/>
                    <SolidColorBrush x:Key="Background.Sub" Color="#FFCFC8E3"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="#FF332B49"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="#FF63587F"/>
                    <SolidColorBrush x:Key="Text.Disabled" Color="#FF978FB2"/>
                    <SolidColorBrush x:Key="Text.CommonAvatar" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="Text.Tag" Color="#FFFBF9FF"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="#FFFCFBFF"/>

                    <SolidColorBrush x:Key="Button.Background" Color="#64C5BBDD"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="#80D3CBEB"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="#6B8674B0"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="#70927BD1"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="#FF6D54C2"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="#FF8368D1"/>

                    <SolidColorBrush x:Key="GridSplitter.Background" Color="#FFB9ABD9"/>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <Style Selector="Border.overlaybackground">
            <Setter Property="Background" Value="#80000000"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        
        <Style Selector="Border.commonavatar">
            <Setter Property="Background" Value="{DynamicResource Background.CommonAvatar}"/>
        </Style>

        <Style Selector="TextBlock.commonavatar">
            <Setter Property="Foreground" Value="{DynamicResource Text.CommonAvatar}"/>
        </Style>

        <Style Selector="Border.tag">
            <Setter Property="Background" Value="{DynamicResource Background.Tag}"/>
        </Style>

        <Style Selector="TextBlock.tag">
            <Setter Property="Foreground" Value="{DynamicResource Text.Tag}"/>
        </Style>

        <Style Selector="Border.panelbackground">
            <Setter Property="Background" Value="{DynamicResource Background.Panel}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.BorderBrush}"/>
        </Style>

        <Style Selector="Border.overlay">
            <Setter Property="Background" Value="{DynamicResource Background.Main}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style Selector="Button.button">
            <Setter Property="Background" Value="{DynamicResource Button.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.BorderBrush}"/>
        </Style>

        <Style Selector="Button.button:pointerover">
            <Setter Property="Background" Value="{DynamicResource Button.Background.PointerOver}"/>
        </Style>

        <Style Selector="Button.button /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Button.Background}"/>
        </Style>

        <Style Selector="Button.button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Button.Background.PointerOver}"/>
        </Style>

        <Style Selector="Button.accentbutton">
            <Setter Property="Background" Value="{DynamicResource Button.AccentBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.BorderBrush}"/>
        </Style>

        <Style Selector="Button.accentbutton:pointerover">
            <Setter Property="Background" Value="{DynamicResource Button.AccentBackground.PointerOver}"/>
        </Style>

        <Style Selector="Button.accentbutton /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Button.AccentBackground}"/>
        </Style>

        <Style Selector="Button.accentbutton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Button.AccentBackground.PointerOver}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Accent}"/>
        </Style>

        <Style Selector="Button.pagebutton">
            <Setter Property="Width" Value="50"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.sidepanelbutton">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="ScrollBar">
            <Setter Property="HideDelay" Value="00:00:00"/>
            <Setter Property="ShowDelay" Value="00:00:00"/>
        </Style>

        <Style Selector="TextBlock.settingslabel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style Selector="TextBlock.settingslabel.title">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        </Style>

        <Style Selector="TextBlock.settingslabel.description">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        </Style>

        <materialIcons:MaterialIconStyles/>
        
        <FluentTheme/>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </Application.Styles>

</Application>
