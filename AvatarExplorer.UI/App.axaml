<Application xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AvatarExplorer.UI"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="AvatarExplorer.UI.App"
        RequestedThemeVariant="Dark">
        <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- 画面全体や通常パネルの背景 -->
                    <SolidColorBrush x:Key="Background.Window" Color="rgba(234,234,234,0.506)"/>
                    <!-- モーダルやオーバーレイの背景 -->
                    <SolidColorBrush x:Key="Background.Overlay" Color="rgba(215,215,215,1.0)"/>
                    <!-- カードや内側領域の面色 -->
                    <SolidColorBrush x:Key="Background.Surface" Color="rgba(220,220,220,1.0)"/>

                    <!-- 区切り線の色 -->
                    <SolidColorBrush x:Key="Separator.Background" Color="rgba(0,0,0,0.133)"/>

                    <!-- 主文言の色 -->
                    <SolidColorBrush x:Key="Text.Primary" Color="rgba(26,26,26,1.0)"/>
                    <!-- 補助文言の色 -->
                    <SolidColorBrush x:Key="Text.Secondary" Color="rgba(85,85,85,1.0)"/>
                    <!-- アクセントボタン上の文字色 -->
                    <SolidColorBrush x:Key="Text.Accent" Color="rgba(255,255,255,1.0)"/>

                    <!-- 通常ボタンの背景 -->
                    <SolidColorBrush x:Key="Button.Background" Color="rgba(222,226,226,0.353)"/>
                    <!-- 通常ボタンのホバー背景 -->
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="rgba(209,215,215,0.455)"/>
                    <!-- ボタン枠線の色 -->
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="rgba(128,128,128,0.416)"/>
                    <!-- 選択中の強調色 -->
                    <SolidColorBrush x:Key="Button.Selected" Color="rgba(0,169,0,0.525)"/>
                    <!-- アクセントボタンの背景 -->
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="rgba(47,126,203,1.0)"/>
                    <!-- アクセントボタンのホバー背景 -->
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="rgba(63,143,222,1.0)"/>

                    <!-- パネル枠線の色 -->
                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="rgba(128,128,128,0.416)"/>

                    <!-- 共通素体アバターの背景 -->
                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="rgba(0,128,0,1.0)"/>
                    <!-- 共通素体アバターの文字色 -->
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="rgba(255,255,255,1.0)"/>

                    <!-- タグの背景 -->
                    <SolidColorBrush x:Key="Tag.Background" Color="rgba(43,120,191,1.0)"/>
                    <!-- タグの文字色 -->
                    <SolidColorBrush x:Key="Tag.Text" Color="rgba(255,255,255,1.0)"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Background.Window" Color="rgba(65,65,65,0.424)"/>
                    <SolidColorBrush x:Key="Background.Overlay" Color="rgba(51,51,51,1.0)"/>
                    <SolidColorBrush x:Key="Background.Surface" Color="rgba(30,30,30,1.0)"/>

                    <SolidColorBrush x:Key="Separator.Background" Color="rgba(255,255,255,0.133)"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="rgba(242,242,242,1.0)"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="rgba(176,176,176,1.0)"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="rgba(255,255,255,1.0)"/>

                    <SolidColorBrush x:Key="Button.Background" Color="rgba(255,255,255,0.2)"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="rgba(255,255,255,0.302)"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="rgba(0,0,0,0.0)"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="rgba(0,169,0,0.525)"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="rgba(74,144,226,1.0)"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="rgba(94,160,234,1.0)"/>

                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="rgba(0,0,0,0.0)"/>

                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="rgba(0,128,0,1.0)"/>
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="rgba(255,255,255,1.0)"/>

                    <SolidColorBrush x:Key="Tag.Background" Color="rgba(43,120,191,1.0)"/>
                    <SolidColorBrush x:Key="Tag.Text" Color="rgba(255,255,255,1.0)"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static ui:AppThemeVariants.Sakura}">
                    <SolidColorBrush x:Key="Background.Window" Color="rgba(242,228,232,0.51)"/>
                    <SolidColorBrush x:Key="Background.Overlay" Color="rgba(232,222,225,1.0)"/>
                    <SolidColorBrush x:Key="Background.Surface" Color="rgba(215,196,203,1.0)"/>

                    <SolidColorBrush x:Key="Separator.Background" Color="rgba(178,127,145,0.133)"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="rgba(75,49,59,1.0)"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="rgba(109,78,89,1.0)"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="rgba(255,248,251,1.0)"/>

                    <SolidColorBrush x:Key="Button.Background" Color="rgba(214,190,199,0.392)"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="rgba(224,204,212,0.502)"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="rgba(178,127,145,0.42)"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="rgba(200,131,162,0.439)"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="rgba(201,107,221,1.0)"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="rgba(213,123,230,1.0)"/>

                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="rgba(178,127,145,0.42)"/>

                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="rgba(194,79,123,1.0)"/>
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="rgba(255,255,255,1.0)"/>

                    <SolidColorBrush x:Key="Tag.Background" Color="rgba(209,127,168,1.0)"/>
                    <SolidColorBrush x:Key="Tag.Text" Color="rgba(255,247,250,1.0)"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static ui:AppThemeVariants.Mint}">
                    <SolidColorBrush x:Key="Background.Window" Color="rgba(221,237,228,0.51)"/>
                    <SolidColorBrush x:Key="Background.Overlay" Color="rgba(220,231,225,1.0)"/>
                    <SolidColorBrush x:Key="Background.Surface" Color="rgba(198,216,208,1.0)"/>

                    <SolidColorBrush x:Key="Separator.Background" Color="rgba(107,156,142,0.133)"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="rgba(37,59,53,1.0)"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="rgba(69,100,89,1.0)"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="rgba(246,255,251,1.0)"/>

                    <SolidColorBrush x:Key="Button.Background" Color="rgba(178,204,191,0.392)"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="rgba(196,217,206,0.502)"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="rgba(107,156,142,0.42)"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="rgba(137,192,173,0.439)"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="rgba(110,117,210,1.0)"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="rgba(131,142,224,1.0)"/>

                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="rgba(107,156,142,0.42)"/>

                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="rgba(40,118,92,1.0)"/>
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="rgba(255,255,255,1.0)"/>

                    <SolidColorBrush x:Key="Tag.Background" Color="rgba(99,184,146,1.0)"/>
                    <SolidColorBrush x:Key="Tag.Text" Color="rgba(247,255,252,1.0)"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static ui:AppThemeVariants.Lavender}">
                    <SolidColorBrush x:Key="Background.Window" Color="rgba(221,214,240,0.51)"/>
                    <SolidColorBrush x:Key="Background.Overlay" Color="rgba(224,219,238,1.0)"/>
                    <SolidColorBrush x:Key="Background.Surface" Color="rgba(207,200,227,1.0)"/>

                    <SolidColorBrush x:Key="Separator.Background" Color="rgba(134,116,176,0.133)"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="rgba(51,43,73,1.0)"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="rgba(82,72,111,1.0)"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="rgba(252,251,255,1.0)"/>

                    <SolidColorBrush x:Key="Button.Background" Color="rgba(197,187,221,0.392)"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="rgba(211,203,235,0.502)"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="rgba(134,116,176,0.42)"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="rgba(146,123,209,0.439)"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="rgba(109,84,194,1.0)"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="rgba(131,104,209,1.0)"/>

                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="rgba(134,116,176,0.42)"/>

                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="rgba(91,69,178,1.0)"/>
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="rgba(255,255,255,1.0)"/>

                    <SolidColorBrush x:Key="Tag.Background" Color="rgba(143,118,221,1.0)"/>
                    <SolidColorBrush x:Key="Tag.Text" Color="rgba(251,249,255,1.0)"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static ui:AppThemeVariants.Ocean}">
                    <SolidColorBrush x:Key="Background.Window" Color="rgba(71,99,123,0.51)"/>
                    <SolidColorBrush x:Key="Background.Overlay" Color="rgba(64,88,107,1.0)"/>
                    <SolidColorBrush x:Key="Background.Surface" Color="rgba(51,71,89,1.0)"/>

                    <SolidColorBrush x:Key="Separator.Background" Color="rgba(127,164,188,0.133)"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="rgba(244,250,255,1.0)"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="rgba(199,216,228,1.0)"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="rgba(255,255,255,1.0)"/>

                    <SolidColorBrush x:Key="Button.Background" Color="rgba(78,112,134,0.392)"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="rgba(97,136,161,0.502)"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="rgba(127,164,188,0.42)"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="rgba(150,199,223,0.439)"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="rgba(45,154,201,1.0)"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="rgba(71,172,214,1.0)"/>

                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="rgba(127,164,188,0.42)"/>

                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="rgba(31,127,166,1.0)"/>
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="rgba(255,255,255,1.0)"/>

                    <SolidColorBrush x:Key="Tag.Background" Color="rgba(79,168,204,1.0)"/>
                    <SolidColorBrush x:Key="Tag.Text" Color="rgba(255,255,255,1.0)"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static ui:AppThemeVariants.Sunset}">
                    <SolidColorBrush x:Key="Background.Window" Color="rgba(246,227,212,0.51)"/>
                    <SolidColorBrush x:Key="Background.Overlay" Color="rgba(240,221,208,1.0)"/>
                    <SolidColorBrush x:Key="Background.Surface" Color="rgba(227,204,189,1.0)"/>

                    <SolidColorBrush x:Key="Separator.Background" Color="rgba(185,133,102,0.133)"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="rgba(75,47,34,1.0)"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="rgba(109,70,55,1.0)"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="rgba(255,251,247,1.0)"/>

                    <SolidColorBrush x:Key="Button.Background" Color="rgba(215,184,166,0.392)"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="rgba(226,201,186,0.502)"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="rgba(185,133,102,0.42)"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="rgba(207,138,99,0.439)"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="rgba(224,122,87,1.0)"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="rgba(235,143,109,1.0)"/>

                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="rgba(185,133,102,0.42)"/>

                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="rgba(201,93,61,1.0)"/>
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="rgba(255,255,255,1.0)"/>

                    <SolidColorBrush x:Key="Tag.Background" Color="rgba(217,144,79,1.0)"/>
                    <SolidColorBrush x:Key="Tag.Text" Color="rgba(255,251,248,1.0)"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static ui:AppThemeVariants.Forest}">
                    <SolidColorBrush x:Key="Background.Window" Color="rgba(216,228,215,0.51)"/>
                    <SolidColorBrush x:Key="Background.Overlay" Color="rgba(214,226,213,1.0)"/>
                    <SolidColorBrush x:Key="Background.Surface" Color="rgba(194,210,192,1.0)"/>

                    <SolidColorBrush x:Key="Separator.Background" Color="rgba(95,139,105,0.133)"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="rgba(34,51,39,1.0)"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="rgba(61,88,67,1.0)"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="rgba(248,255,250,1.0)"/>

                    <SolidColorBrush x:Key="Button.Background" Color="rgba(157,186,160,0.392)"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="rgba(178,200,180,0.502)"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="rgba(95,139,105,0.42)"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="rgba(131,176,127,0.439)"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="rgba(78,124,82,1.0)"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="rgba(99,151,103,1.0)"/>

                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="rgba(95,139,105,0.42)"/>

                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="rgba(46,110,61,1.0)"/>
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="rgba(255,255,255,1.0)"/>

                    <SolidColorBrush x:Key="Tag.Background" Color="rgba(77,148,104,1.0)"/>
                    <SolidColorBrush x:Key="Tag.Text" Color="rgba(248,255,249,1.0)"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static ui:AppThemeVariants.Mocha}">
                    <SolidColorBrush x:Key="Background.Window" Color="rgba(110,93,86,0.51)"/>
                    <SolidColorBrush x:Key="Background.Overlay" Color="rgba(110,91,85,1.0)"/>
                    <SolidColorBrush x:Key="Background.Surface" Color="rgba(91,75,69,1.0)"/>

                    <SolidColorBrush x:Key="Separator.Background" Color="rgba(193,154,135,0.133)"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="rgba(247,240,236,1.0)"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="rgba(220,201,192,1.0)"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="rgba(255,255,255,1.0)"/>

                    <SolidColorBrush x:Key="Button.Background" Color="rgba(134,107,99,0.392)"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="rgba(156,127,117,0.502)"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="rgba(193,154,135,0.42)"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="rgba(176,122,102,0.439)"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="rgba(185,130,98,1.0)"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="rgba(200,148,120,1.0)"/>

                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="rgba(193,154,135,0.42)"/>

                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="rgba(135,87,70,1.0)"/>
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="rgba(255,255,255,1.0)"/>
                    
                    <SolidColorBrush x:Key="Tag.Background" Color="rgba(178,125,98,1.0)"/>
                    <SolidColorBrush x:Key="Tag.Text" Color="rgba(255,255,255,1.0)"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static ui:AppThemeVariants.Slate}">
                    <SolidColorBrush x:Key="Background.Window" Color="rgba(84,90,103,0.51)"/>
                    <SolidColorBrush x:Key="Background.Overlay" Color="rgba(87,94,110,1.0)"/>
                    <SolidColorBrush x:Key="Background.Surface" Color="rgba(69,76,90,1.0)"/>

                    <SolidColorBrush x:Key="Separator.Background" Color="rgba(154,165,186,0.133)"/>

                    <SolidColorBrush x:Key="Text.Primary" Color="rgba(245,247,250,1.0)"/>
                    <SolidColorBrush x:Key="Text.Secondary" Color="rgba(202,210,220,1.0)"/>
                    <SolidColorBrush x:Key="Text.Accent" Color="rgba(255,255,255,1.0)"/>

                    <SolidColorBrush x:Key="Button.Background" Color="rgba(106,115,132,0.392)"/>
                    <SolidColorBrush x:Key="Button.Background.PointerOver" Color="rgba(126,136,154,0.502)"/>
                    <SolidColorBrush x:Key="Button.BorderBrush" Color="rgba(154,165,186,0.42)"/>
                    <SolidColorBrush x:Key="Button.Selected" Color="rgba(144,164,197,0.439)"/>
                    <SolidColorBrush x:Key="Button.AccentBackground" Color="rgba(104,132,164,1.0)"/>
                    <SolidColorBrush x:Key="Button.AccentBackground.PointerOver" Color="rgba(122,150,182,1.0)"/>

                    <SolidColorBrush x:Key="Panel.BorderBrush" Color="rgba(154,165,186,0.42)"/>

                    <SolidColorBrush x:Key="CommonAvatar.Background" Color="rgba(85,111,138,1.0)"/>
                    <SolidColorBrush x:Key="CommonAvatar.Text" Color="rgba(255,255,255,1.0)"/>

                    <SolidColorBrush x:Key="Tag.Background" Color="rgba(124,146,173,1.0)"/>
                    <SolidColorBrush x:Key="Tag.Text" Color="rgba(255,255,255,1.0)"/>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <Style Selector="Border.overlaybackground">
            <Setter Property="Background" Value="rgba(0,0,0,0.502)"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        
        <Style Selector="Border.commonavatar">
            <Setter Property="Background" Value="{DynamicResource CommonAvatar.Background}"/>
        </Style>

        <Style Selector="TextBlock.commonavatar">
            <Setter Property="Foreground" Value="{DynamicResource CommonAvatar.Text}"/>
        </Style>

        <Style Selector="Border.tag">
            <Setter Property="Background" Value="{DynamicResource Tag.Background}"/>
        </Style>

        <Style Selector="TextBlock.tag">
            <Setter Property="Foreground" Value="{DynamicResource Tag.Text}"/>
        </Style>

        <Style Selector="Border.panelbackground">
            <Setter Property="Background" Value="{DynamicResource Background.Window}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Panel.BorderBrush}"/>
        </Style>

        <Style Selector="Border.overlay">
            <Setter Property="Background" Value="{DynamicResource Background.Overlay}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style Selector="Button.button">
            <Setter Property="Background" Value="{DynamicResource Button.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.BorderBrush}"/>
        </Style>

        <Style Selector="Button.button:pointerover">
            <Setter Property="Background" Value="{DynamicResource Button.Background.PointerOver}"/>
        </Style>

        <Style Selector="Button.button /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Button.Background}"/>
        </Style>

        <Style Selector="Button.button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Button.Background.PointerOver}"/>
        </Style>

        <Style Selector="Button.accentbutton">
            <Setter Property="Background" Value="{DynamicResource Button.AccentBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.BorderBrush}"/>
        </Style>

        <Style Selector="Button.accentbutton:pointerover">
            <Setter Property="Background" Value="{DynamicResource Button.AccentBackground.PointerOver}"/>
        </Style>

        <Style Selector="Button.accentbutton /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Button.AccentBackground}"/>
        </Style>

        <Style Selector="Button.accentbutton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Button.AccentBackground.PointerOver}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Accent}"/>
        </Style>

        <Style Selector="Button.pagebutton">
            <Setter Property="Width" Value="50"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.sidepanelbutton">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <Style Selector="Separator.separator">
            <Setter Property="Background" Value="{DynamicResource Separator.Background}"/>
        </Style>

        <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="ScrollBar">
            <Setter Property="HideDelay" Value="00:00:00"/>
            <Setter Property="ShowDelay" Value="00:00:00"/>
        </Style>

        <Style Selector="TextBlock.settingslabel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style Selector="TextBlock.settingslabel.title">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        </Style>

        <Style Selector="TextBlock.settingslabel.description">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        </Style>

        <materialIcons:MaterialIconStyles/>
        
        <FluentTheme/>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </Application.Styles>

</Application>
