// netcoredbgアダプターを使ってAvatarExplorer.UIをデバッグします。
//
// デバッグするには zed-netcoredbg を入れておく必要があります。
// リンク: https://github.com/qwadrox/zed-netcoredbg
// この拡張機能をZedに入れることでデバッグメニューに項目が表示されます。
// 入れないとアダプターが存在しない判定になって一覧に表示されません。
[
    {
        "label": "Debug AvatarExplorer.UI",
        "adapter": "netcoredbg",
        "request": "launch",
        "build": {
            "command": "dotnet",
            "args": [
                "build",
                "\"${ZED_WORKTREE_ROOT}/AvatarExplorer.UI/AvatarExplorer.UI.csproj\"",
                "-c",
                "Debug",
            ],
        },
        "program": "${ZED_WORKTREE_ROOT}/AvatarExplorer.UI/bin/Debug/net10.0/AvatarExplorer.exe",
        "args": [],
        "env": {
            "ASPNETCORE_ENVIRONMENT": "Development",
            "DOTNET_ENVIRONMENT": "Development",
        },
        "stopAtEntry": false,
    },
]
